    function togglePitchVote(ventureId) {
      const v = PITCH_VENTURES.find(item => item.id === ventureId);
      if (!v) return;

      if (v.hasVoted) {
        v.votes -= 1;
        v.hasVoted = false;
      } else {
        v.votes += 1;
        v.hasVoted = true;
      }

      renderPitchPad();
      updateTotalPitchVotes();
    }

    function toggleDirectorsPick(ventureId) {
      const v = PITCH_VENTURES.find(item => item.id === ventureId);
      if (!v) return;

      v.isDirectorsPick = !v.isDirectorsPick;
      renderPitchPad();
    }

    function updateTotalPitchVotes() {
      const total = PITCH_VENTURES.reduce((acc, v) => acc + v.votes, 0);
      const badge = document.getElementById('total-pitch-votes-badge');
      if (badge) {
        badge.textContent = `Total Votes: ${total}`;
      }
    }

    function renderPitchPad() {
      const container = document.getElementById('pitch-grid-container');
      if (!container) return;

      container.innerHTML = PITCH_VENTURES.map(v => `
        <div class="pitch-card ${v.isDirectorsPick ? 'directors-pick-active' : ''}">
