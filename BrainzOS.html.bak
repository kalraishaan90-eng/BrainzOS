    let activeAsgFilter = 'all';
    let asgSearchQuery = '';

    function toggleAssignment(asgId) {
      const item = STUDENT_ASSIGNMENTS_DATA.find(a => a.id === asgId);
      if (!item) return;

      item.completed = !item.completed;
      renderAssignments();
      updateAssignmentMetrics();

      if (window.lucide) lucide.createIcons();
    }

    function updateAssignmentMetrics() {
      const total = STUDENT_ASSIGNMENTS_DATA.length;
      const completed = STUDENT_ASSIGNMENTS_DATA.filter(a => a.completed).length;
      const pending = total - completed;

      // Update Dashboard live stat counter
      const dashCountEl = document.getElementById('dash-assignments-count');
      const dashSubEl = document.getElementById('dash-assignments-sub');
      if (dashCountEl) {
        dashCountEl.textContent = pending < 10 ? '0' + pending : String(pending);
      }
      if (dashSubEl) {
        dashSubEl.textContent = pending === 0 ? 'All coursework submitted!' : `${pending} active tasks pending`;
      }

      // Update Assignments page stat cards
      const asgPendingEl = document.getElementById('asg-pending-count');
      const asgCompletedEl = document.getElementById('asg-completed-count');
      const asgPctEl = document.getElementById('asg-completion-pct');

      if (asgPendingEl) asgPendingEl.textContent = pending < 10 ? '0' + pending : String(pending);
      if (asgCompletedEl) asgCompletedEl.textContent = completed < 10 ? '0' + completed : String(completed);
      if (asgPctEl) {
        const pct = Math.round((completed / total) * 100);
        asgPctEl.textContent = `${pct}% Completed`;
      }

      // Update filter tab badge counts
      const countAll = document.getElementById('asg-count-all');
      const countPending = document.getElementById('count-pending');
      const countCompleted = document.getElementById('count-completed');
      if (countAll) countAll.textContent = total;
      if (countPending) countPending.textContent = pending;
      if (countCompleted) countCompleted.textContent = completed;
    }

    function filterAssignments(filterType) {
      activeAsgFilter = filterType;
      document.querySelectorAll('.asg-filter-btn').forEach(b => b.classList.remove('active'));
      const activeBtn = document.getElementById(`asg-filter-${filterType}`);
      if (activeBtn) activeBtn.classList.add('active');
      renderAssignments();
    }

    function handleAssignmentSearch(query) {
      asgSearchQuery = (query || '').toLowerCase().trim();
      renderAssignments();
    }

    function renderAssignments() {
      const container = document.getElementById('assignments-list-container');
      if (!container) return;

      const filtered = STUDENT_ASSIGNMENTS_DATA.filter(a => {
        // Filter by tab
        if (activeAsgFilter === 'pending' && a.completed) return false;
        if (activeAsgFilter === 'completed' && !a.completed) return false;
        if (activeAsgFilter === 'commerce' && a.stream !== 'commerce') return false;

        // Filter by search
        if (asgSearchQuery) {
          const matchTitle = a.title.toLowerCase().includes(asgSearchQuery);
          const matchSub = a.subject.toLowerCase().includes(asgSearchQuery);
          if (!matchTitle && !matchSub) return false;
        }
        return true;
      });

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="card" style="text-align: center; padding: 40px 20px; color: var(--color-ink-muted);">
            <i data-lucide="check-circle" aria-hidden="true" style="width: 32px; height: 32px; color: var(--color-sage); margin: 0 auto 10px;"></i>
            <h4 style="margin-bottom: 4px;">No assignments match this filter</h4>
            <p class="subtext">Try changing the filter or search query above.</p>
          </div>
        `;
        if (window.lucide) lucide.createIcons();
        return;
      }

      container.innerHTML = filtered.map(a => `
        <div class="asg-card ${a.completed ? 'completed' : ''}" onclick="toggleAssignment('${a.id}')">
          <div class="asg-checkbox-box">
            ${a.completed ? '<i data-lucide="check" aria-hidden="true" style="width: 15px; height: 15px;"></i>' : ''}
          </div>
          <div style="flex: 1; min-width: 0;">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 2px;">
              <span class="asg-title" style="font-size: var(--text-base); font-weight: 600; color: var(--color-ink);">${a.title}</span>
              <span class="subtext" style="font-weight: 600; white-space: nowrap;">${a.dueText}</span>
            </div>
            <div class="asg-meta-row">
              <span class="badge badge-blue" style="font-size: 0.65rem;">${a.subject}</span>
              <span class="subtext" style="font-size: 0.75rem;">${a.weight}</span>
              <span class="subtext" style="font-size: 0.75rem;">· ${a.tag}</span>
              ${a.completed ? '<span class="badge badge-sage" style="font-size: 0.65rem;">Completed</span>' : ''}
            </div>
          </div>
        </div>
      `).join('');

      if (window.lucide) lucide.createIcons();
    }

    /* -------------------------------------------------------------------------
       C. DIGITAL PASS 3D FLIP CARD & CANAVS QR ENGINE
       ------------------------------------------------------------------------- */
    let passIsFlipped = false;

    function togglePassFlip() {
      const card = document.getElementById('pass-card-element');
      if (!card) return;
      passIsFlipped = !passIsFlipped;
      if (passIsFlipped) {
        card.classList.add('flipped');
      } else {
        card.classList.remove('flipped');
      }
    }

    function renderDigitalPassQR() {
      const canvas = document.getElementById('pass-qr-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const size = canvas.width;
      ctx.clearRect(0, 0, size, size);

      ctx.fillStyle = '#FFFFFF';
      ctx.fillRect(0, 0, size, size);

      const modules = 25;
      const cellSize = (size - 20) / modules;
      const offset = 10;

      function drawFinder(row, col) {
        ctx.fillStyle = '#1C232B';
        ctx.fillRect(offset + col * cellSize, offset + row * cellSize, 7 * cellSize, 7 * cellSize);
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(offset + (col + 1) * cellSize, offset + (row + 1) * cellSize, 5 * cellSize, 5 * cellSize);
        ctx.fillStyle = '#1C232B';
        ctx.fillRect(offset + (col + 2) * cellSize, offset + (row + 2) * cellSize, 3 * cellSize, 3 * cellSize);
      }

      drawFinder(0, 0);
      drawFinder(0, modules - 7);
      drawFinder(modules - 7, 0);

      // Timing tracks
      for (let i = 8; i < modules - 8; i++) {
        ctx.fillStyle = (i % 2 === 0) ? '#1C232B' : '#FFFFFF';
        ctx.fillRect(offset + i * cellSize, offset + 6 * cellSize, cellSize, cellSize);
        ctx.fillRect(offset + 6 * cellSize, offset + i * cellSize, cellSize, cellSize);
      }

      // Alignment square
      const ar = 16, ac = 16;
      ctx.fillStyle = '#1C232B';
      ctx.fillRect(offset + ac * cellSize, offset + ar * cellSize, 5 * cellSize, 5 * cellSize);
      ctx.fillStyle = '#FFFFFF';
      ctx.fillRect(offset + (ac + 1) * cellSize, offset + (ar + 1) * cellSize, 3 * cellSize, 3 * cellSize);
      ctx.fillStyle = '#1C232B';
      ctx.fillRect(offset + (ac + 2) * cellSize, offset + (ar + 2) * cellSize, cellSize, cellSize);

      // Data pattern
      const token = "BOS-XIB-041-9F4A-7C21-LIVE-ISHAAN-KALRA";
      let seed = 42;
      for (let i = 0; i < token.length; i++) {
        seed = ((seed << 5) - seed) + token.charCodeAt(i);
        seed |= 0;
      }

      ctx.fillStyle = '#1C232B';
      for (let r = 0; r < modules; r++) {
        for (let c = 0; c < modules; c++) {
          const inTL = r < 8 && c < 8;
          const inTR = r < 8 && c >= modules - 8;
          const inBL = r >= modules - 8 && c < 8;
          const inAlign = r >= 15 && r <= 21 && c >= 15 && c <= 21;
          const inTiming = r === 6 || c === 6;

          if (!inTL && !inTR && !inBL && !inAlign && !inTiming) {
            const val = Math.sin(r * 29.3 + c * 71.7 + seed) * 10000;
            if ((val - Math.floor(val)) > 0.51) {
              ctx.fillRect(offset + c * cellSize, offset + r * cellSize, cellSize - 0.4, cellSize - 0.4);
            }
          }
        }
      }
    }

