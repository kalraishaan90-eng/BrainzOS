<section class="os-page" id="page-teacher-broadcasts">
<div class="page-header">
<div>
<h1 class="page-header-title">Faculty Broadcasts</h1>
<p class="page-header-desc">Compose academic notices and cohort updates. Broadcasts are dispatched in real-time to student feeds.</p>
</div>
</div>
<div class="broadcasts-layout">
<!-- Left Column: Composer -->
<div class="composer-card">
<div style="display: flex; align-items: center; gap: 10px; margin-bottom: 18px;">
<div style="width: 34px; height: 34px; border-radius: 10px; background: rgba(106, 142, 174, 0.14); display: flex; align-items: center; justify-content: center; color: var(--color-blue);">
<i data-lucide="megaphone" aria-hidden="true" style="width: 18px; height: 18px;"></i>
</div>
<div>
<h3 style="font-size: 1.15rem; font-weight: 600;">Compose Broadcast</h3>
<p class="subtext">Signed as Aarav Mehta (Teacher)</p>
</div>
</div>
<!-- Inline Success Confirmation Banner (Checklist A13) -->
<div id="broadcast-success-banner" class="form-success-banner" style="display: none;" role="status">
  <i data-lucide="check-circle-2" style="width: 18px; height: 18px; color: var(--color-sage);" aria-hidden="true"></i>
  <span id="broadcast-success-text">Broadcast published live. Transmitted to 36 student dashboards.</span>
</div>

<form id="broadcast-form" novalidate onsubmit="handlePublishBroadcast(event)">
<div class="form-group">
<label class="form-label" for="broadcast-headline">Headline / Subject</label>
<input class="composer-input" id="broadcast-headline" placeholder="e.g., Political Science Quiz Review Guidelines" required="" type="text" aria-describedby="broadcast-headline-error" oninput="clearBroadcastErrors()"/>
<div class="form-field-error" id="broadcast-headline-error" style="display: none;" role="alert">
  <i data-lucide="alert-circle" style="width: 14px; height: 14px;" aria-hidden="true"></i>
  <span>Headline must be at least 4 characters long.</span>
</div>
</div>
<div class="form-group">
<label class="form-label" for="broadcast-audience">Target Audience</label>
<select class="composer-select" id="broadcast-audience" required="">
<option value="XI Commerce">XI Commerce (All Sections)</option>
<option value="XI-B Commerce">XI-B Commerce Only</option>
<option value="XI-A Commerce">XI-A Commerce Only</option>
<option value="Whole School">Whole School &amp; Directorate</option>
<option value="Staff Only">Staff &amp; Faculty Only</option>
</select>
</div>
<div class="form-group">
<label class="form-label" for="broadcast-message">Message Content</label>
<textarea class="composer-textarea" id="broadcast-message" placeholder="Provide full instructions, reference materials, or deadline announcements..." required="" aria-describedby="broadcast-message-error" oninput="clearBroadcastErrors()"></textarea>
<div class="form-field-error" id="broadcast-message-error" style="display: none;" role="alert">
  <i data-lucide="alert-circle" style="width: 14px; height: 14px;" aria-hidden="true"></i>
  <span>Announcement message must be at least 10 characters long.</span>
</div>
</div>
<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 18px;">
<button class="btn-secondary" onclick="resetBroadcastForm()" type="button" aria-label="Clear composer fields">Clear</button>
<button class="btn-primary" id="publish-broadcast-btn" type="submit" aria-label="Publish Broadcast to selected audience">
<i data-lucide="send" style="width: 16px; height: 16px;" aria-hidden="true"></i>
<span>Publish Broadcast</span>
</button>
</div>
</form>
</div>
<!-- Right Column: Recent Announcements Feed -->
<div>
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
<h3 style="font-size: 1.25rem; font-weight: 600;">Recent Announcements</h3>
<span class="badge badge-sage" id="broadcasts-count-badge">3 Published</span>
</div>
<div class="announcements-feed" id="announcements-feed-container">
<!-- Prepopulated and prepended dynamically -->
</div>
</div>
</div>
</section>

