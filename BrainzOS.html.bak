    /**
     * Appends a new verified event to the shared in-memory audit ledger.
     */
    function logAuditEvent(actor, action, device) {
      const now = new Date();
      const timeStr = now.toTimeString().split(' ')[0]; // HH:MM:SS
      const entry = {
        time: timeStr,
        actor: actor || 'Dr. Rhea Sharma',
        action: action,
        device: device || 'Admin Console',
        isNew: true
      };

      AUDIT_LOGS.unshift(entry);
      renderAuditLogsTable();
      showToast('Audit Log Written', `Recorded: "${action}"`);
    }

    function renderAuditLogsTable(filterQuery = '') {
      const tbody = document.getElementById('audit-logs-table-body');
      if (!tbody) return;

      tbody.innerHTML = '';
      const q = filterQuery.toLowerCase().trim();

      const filtered = AUDIT_LOGS.filter(entry => {
        if (!q) return true;
        return entry.actor.toLowerCase().includes(q) ||
               entry.action.toLowerCase().includes(q) ||
               entry.device.toLowerCase().includes(q);
      });

      const countIndicator = document.getElementById('audit-count-indicator');
      if (countIndicator) {
        countIndicator.textContent = `Showing ${filtered.length} entries · Session in-memory ledger`;
      }

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" style="text-align: center; padding: 32px; color: var(--color-ink-subtle);">
              No audit logs matched "${filterQuery}".
            </td>
          </tr>
        `;
        return;
      }

      filtered.forEach((entry, idx) => {
        const tr = document.createElement('tr');
        if (entry.isNew) {
          tr.className = 'row-highlight-new';
          setTimeout(() => { entry.isNew = false; }, 2600);
        }

        let actorBadgeClass = 'badge-beige';
        if (entry.actor.includes('Dr. Rhea') || entry.actor.includes('Director')) {
          actorBadgeClass = 'badge-blue';
        } else if (entry.actor.includes('System')) {
          actorBadgeClass = 'badge-sage';
        }

        tr.innerHTML = `
          <td style="font-family: monospace; font-size: 0.8rem; color: var(--color-ink-muted);">${entry.time}</td>
          <td>
            <span class="badge ${actorBadgeClass}">
              <i data-lucide="${entry.actor.includes('System') ? 'cpu' : 'user'}" aria-hidden="true" style="width: 12px; height: 12px;"></i>
              <span>${entry.actor}</span>
            </span>
          </td>
          <td style="font-weight: 500; color: var(--color-ink);">${entry.action}</td>
          <td>
            <span style="font-size: var(--text-xs); color: var(--color-ink-subtle);">${entry.device}</span>
          </td>
          <td style="text-align: right;">
            <span style="display: inline-flex; align-items: center; gap: 5px; font-size: 0.72rem; color: var(--color-sage); font-weight: 600;">
              <i data-lucide="check" aria-hidden="true" style="width: 13px; height: 13px;"></i>
              <span>Verified</span>
            </span>
          </td>
        `;
        tbody.appendChild(tr);
      });

      if (window.lucide) lucide.createIcons();
    }

    function handleAuditSearch(e) {
      renderAuditLogsTable(e.target.value);
    }

    function exportAuditLogsCSV() {
      let csvContent = "data:text/csv;charset=utf-8,Time,Actor,Action,Device,Status\n";
      AUDIT_LOGS.forEach(row => {
        csvContent += `"${row.time}","${row.actor}","${row.action.replace(/"/g, '""')}","${row.device}","Verified"\n`;
      });

      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", `BrainzOS_Directorial_Audit_${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      logAuditEvent('Dr. Rhea Sharma', 'Exported Audit Ledger to CSV', 'Admin Console');
    }

