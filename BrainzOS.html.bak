const STATUS_CYCLE = ['Present', 'Late', 'Absent'];

    function renderAttendanceTable() {
      const tbody = document.getElementById('attendance-tbody');
      tbody.innerHTML = '';

      let presentCount = 0;
      let lateCount = 0;
      let absentCount = 0;

      ATTENDANCE_DATA.forEach(student => {
        if (student.status === 'Present') presentCount++;
        else if (student.status === 'Late') lateCount++;
        else if (student.status === 'Absent') absentCount++;

        const tr = document.createElement('tr');
        tr.id = `row-${student.id}`;

        let pillClass = 'status-pill-present';
        let pillDotColor = 'var(--color-sage)';
        if (student.status === 'Late') {
          pillClass = 'status-pill-late';
          pillDotColor = 'var(--color-status-amber)';
        } else if (student.status === 'Absent') {
          pillClass = 'status-pill-absent';
          pillDotColor = 'var(--color-status-red)';
        }

        tr.innerHTML = `
          <td>
            <div style="font-weight: 600; color: var(--color-ink);">${student.name}</div>
            <div style="font-size: var(--text-xs); color: var(--color-ink-subtle);">Roll: ${student.roll}</div>
          </td>
          <td>
            <span style="font-variant-numeric: tabular-nums; font-weight: 500;">${student.checkIn}</span>
          </td>
          <td>
            <button 
              type="button" 
              class="status-pill-btn ${pillClass}" 
              onclick="cycleStudentStatus('${student.id}')"
              title="Click to change status"
            >
              <span class="role-dot" style="background: ${pillDotColor};"></span>
              <span>${student.status}</span>
              <i data-lucide="refresh-cw" aria-hidden="true" style="width: 12px; height: 12px; opacity: 0.6; margin-left: 2px;"></i>
            </button>
          </td>
          <td>
            <span class="badge badge-beige" style="font-family: monospace; font-size: 13px;">${student.seat}</span>
          </td>
        `;
        tbody.appendChild(tr);
      });

      // Update counters in toolbar
      document.getElementById('count-present-val').textContent = presentCount;
      document.getElementById('count-late-val').textContent = lateCount;
      document.getElementById('count-absent-val').textContent = absentCount;

      // Update live class overview card badge and ring
      updateOverviewAttendanceTelemetry(presentCount, ATTENDANCE_DATA.length);

      if (window.lucide) lucide.createIcons();
    }

    function cycleStudentStatus(studentId) {
      const student = ATTENDANCE_DATA.find(s => s.id === studentId);
      if (!student) return;

      const currentIndex = STATUS_CYCLE.indexOf(student.status);
      const nextIndex = (currentIndex + 1) % STATUS_CYCLE.length;
      student.status = STATUS_CYCLE[nextIndex];

      if (student.status === 'Present' && student.checkIn === '—') {
        student.checkIn = '12:05 PM';
      } else if (student.status === 'Absent') {
        student.checkIn = '—';
      }

      renderAttendanceTable();
      showToast(`Updated ${student.name} to ${student.status}`);
    }

    function markAllPresent() {
      ATTENDANCE_DATA.forEach(s => {
        s.status = 'Present';
        if (s.checkIn === '—') s.checkIn = '11:58 AM';
      });
      renderAttendanceTable();
      showToast('All 9 students marked Present');
    }

    function saveAttendanceSnapshot() {
      showToast('Attendance roll synced with institutional registry');
    }

    function updateOverviewAttendanceTelemetry(samplePresent, sampleTotal) {
      // Calculate scaled attendance for 36-student class
      const totalEnrolled = 36;
      const absentCount = ATTENDANCE_DATA.filter(s => s.status === 'Absent').length;
      const lateCount = ATTENDANCE_DATA.filter(s => s.status === 'Late').length;
      const presentCount = totalEnrolled - absentCount;
      const pct = Math.round((presentCount / totalEnrolled) * 100);

      const xibBadge = document.getElementById('xib-present-badge');
      if (xibBadge) xibBadge.textContent = `${presentCount}/${totalEnrolled} present`;

      const xibBar = document.getElementById('bar-fill-xib');
      if (xibBar) xibBar.style.width = `${pct}%`;

      const ringXib = document.getElementById('ring-xib');
      if (ringXib) ringXib.setAttribute('stroke-dasharray', `${pct}, 100`);

      const ringText = document.getElementById('ring-xib-text');
      if (ringText) ringText.textContent = `${pct}%`;

      const barCounts = document.getElementById('xib-bar-counts');
      if (barCounts) barCounts.textContent = `${presentCount} Present · ${lateCount} Late · ${absentCount} Absent`;

      const statPresent = document.getElementById('overview-stat-present');
      if (statPresent) {
        const schoolTotal = 151;
        const totalPresent = 108 + presentCount;
        statPresent.textContent = `${totalPresent}/${schoolTotal}`;
      }
    }

    /* =========================================================================
       5. MODULE 3: GRADEBOOK (LIVE RECALCULATION & SCORE BANDS)
       ========================================================================= */
    function renderGradebookTable() {
      const tbody = document.getElementById('gradebook-tbody');
      tbody.innerHTML = '';

      let totalPercentageSum = 0;

      GRADEBOOK_DATA.forEach(student => {
        const totalScore = student.quiz + student.caseStudy + student.presentation;
        const maxScore = 100;
        const percentage = Math.round((totalScore / maxScore) * 100 * 10) / 10;
        totalPercentageSum += percentage;

        let bandClass = 'score-band-mid';
        let bandLabel = 'Proficient';
        if (percentage >= 85) {
          bandClass = 'score-band-high';
          bandLabel = 'Excellent';
        } else if (percentage < 70) {
          bandClass = 'score-band-low';
          bandLabel = 'Needs Review';
        }

        const tr = document.createElement('tr');
        tr.id = `grade-row-${student.id}`;

        tr.innerHTML = `
          <td>
            <div style="font-weight: 600; color: var(--color-ink);">${student.name}</div>
            <div style="font-size: var(--text-xs); color: var(--color-ink-subtle);">Roll: ${student.roll}</div>
          </td>
          <td style="text-align: center;">
            <input 
              type="number" 
              min="0" 
              max="20" 
              class="grade-score-input" 
              value="${student.quiz}" 
              oninput="handleScoreChange('${student.id}', 'quiz', this.value)"
            />
          </td>
          <td style="text-align: center;">
            <input 
              type="number" 
              min="0" 
              max="40" 
              class="grade-score-input" 
              value="${student.caseStudy}" 
              oninput="handleScoreChange('${student.id}', 'caseStudy', this.value)"
            />
          </td>
          <td style="text-align: center;">
            <input 
              type="number" 
              min="0" 
              max="40" 
              class="grade-score-input" 
              value="${student.presentation}" 
              oninput="handleScoreChange('${student.id}', 'presentation', this.value)"
            />
          </td>
          <td>
            <div style="display: flex; align-items: center; gap: 12px;">
              <span class="score-badge ${bandClass}" id="badge-${student.id}">
                ${percentage.toFixed(1)}% · ${bandLabel}
              </span>
            </div>
          </td>
        `;
        tbody.appendChild(tr);
      });

      const overallAvg = (totalPercentageSum / GRADEBOOK_DATA.length).toFixed(1);
      const avgEl = document.getElementById('gradebook-class-average');
      if (avgEl) avgEl.textContent = `${overallAvg}%`;
    }

    function handleScoreChange(studentId, field, rawValue) {
      const student = GRADEBOOK_DATA.find(s => s.id === studentId);
      if (!student) return;

      const numVal = Math.max(0, parseFloat(rawValue) || 0);
      student[field] = numVal;

      const totalScore = student.quiz + student.caseStudy + student.presentation;
      const maxScore = 100;
      const percentage = Math.round((totalScore / maxScore) * 100 * 10) / 10;

      let bandClass = 'score-band-mid';
      let bandLabel = 'Proficient';
      if (percentage >= 85) {
        bandClass = 'score-band-high';
        bandLabel = 'Excellent';
      } else if (percentage < 70) {
        bandClass = 'score-band-low';
        bandLabel = 'Needs Review';
      }

      const badge = document.getElementById(`badge-${student.id}`);
      if (badge) {
        badge.className = `score-badge ${bandClass}`;
        badge.textContent = `${percentage.toFixed(1)}% · ${bandLabel}`;
      }

      let newSum = 0;
      GRADEBOOK_DATA.forEach(s => {
        newSum += ((s.quiz + s.caseStudy + s.presentation) / 100) * 100;
      });
      const newClassAvg = (newSum / GRADEBOOK_DATA.length).toFixed(1);
      const avgEl = document.getElementById('gradebook-class-average');
      if (avgEl) avgEl.textContent = `${newClassAvg}%`;
    }

    function exportGradebookCSV() {
      showToast('Exporting Term 1 Gradebook CSV…');
    }

    /* =========================================================================
       6. MODULE 4: CLASS ASSIGNMENTS (CARDS & NEW ASSIGNMENT MODAL)
       ========================================================================= */
    function renderAssignmentsList() {
      const container = document.getElementById('assignments-grid-container');
      if (!container) return;
      container.innerHTML = '';

      TEACHER_ASSIGNMENTS_DATA.forEach(assign => {
        const card = document.createElement('div');
        card.className = 'assignment-card';
        card.id = `assign-card-${assign.id}`;

        card.innerHTML = `
          <div>
            <div class="assignment-tags">
              <span class="badge badge-blue">${escapeHtml(assign.cohort)}</span>
              <span class="badge badge-beige">${escapeHtml(assign.subject)}</span>
              <span class="badge badge-sage" style="margin-left: auto;">Due ${escapeHtml(assign.due)}</span>
            </div>
            <h3 class="assignment-title">${escapeHtml(assign.title)}</h3>
            <div class="assignment-meta-row">
              <span><i data-lucide="clock" style="width: 13px; height: 13px; display: inline-block; vertical-align: middle;" aria-hidden="true"></i> ${escapeHtml(assign.due)}</span>
              <span><i data-lucide="users" style="width: 13px; height: 13px; display: inline-block; vertical-align: middle;" aria-hidden="true"></i> ${escapeHtml(assign.submissions)}</span>
            </div>
          </div>

          <div class="assignment-progress-section">
            <div class="assignment-progress-header">
              <span>Cohort Progress</span>
              <strong>${Number(assign.progress) || 0}%</strong>
            </div>
            <div class="assignment-progress-track">
              <div class="assignment-progress-fill" style="width: ${Number(assign.progress) || 0}%;"></div>
            </div>
          </div>
        `;
        container.appendChild(card);
      });

      // Update stat card on overview
      const statAssignments = document.getElementById('overview-stat-assignments');
      if (statAssignments) {
        statAssignments.textContent = String(TEACHER_ASSIGNMENTS_DATA.length).padStart(2, '0');
      }

      if (window.lucide) lucide.createIcons();
    }

    function openNewAssignmentModal() {
      clearAssignmentErrors();
      const modal = document.getElementById('new-assignment-modal');
      if (modal) modal.classList.add('active');
      setTimeout(() => {
        const titleEl = document.getElementById('new-assign-title');
        if (titleEl) titleEl.focus();
      }, 50);
    }

    function closeNewAssignmentModal() {
      clearAssignmentErrors();
      const modal = document.getElementById('new-assignment-modal');
      if (modal) modal.classList.remove('active');
    }

    function handleAssignmentModalOverlayClick(e) {
      if (e.target.id === 'new-assignment-modal') {
        closeNewAssignmentModal();
      }
    }

    function clearAssignmentErrors() {
      const titleEl = document.getElementById('new-assign-title');
      const titleErr = document.getElementById('new-assign-title-error');
      const dueEl = document.getElementById('new-assign-due');
      const dueErr = document.getElementById('new-assign-due-error');
      if (titleEl) { titleEl.classList.remove('has-error'); titleEl.removeAttribute('aria-invalid'); }
      if (titleErr) titleErr.style.display = 'none';
      if (dueEl) { dueEl.classList.remove('has-error'); dueEl.removeAttribute('aria-invalid'); }
      if (dueErr) dueErr.style.display = 'none';
    }

    function handleCreateAssignment(e) {
      if (e) e.preventDefault();
      clearAssignmentErrors();

      const titleEl = document.getElementById('new-assign-title');
      const cohortEl = document.getElementById('new-assign-class');
      const subjectEl = document.getElementById('new-assign-subject');
      const dueEl = document.getElementById('new-assign-due');

      const title = titleEl ? titleEl.value.trim() : '';
      const cohort = cohortEl ? cohortEl.value : 'XI-B Commerce';
      const subject = subjectEl ? subjectEl.value : 'Political Science';
      const due = dueEl ? dueEl.value.trim() : '';

      let hasError = false;

      // Real Form Validation (Checklist A12 & B9)
      if (!title || title.length < 4) {
        if (titleEl) {
          titleEl.classList.add('has-error');
          titleEl.setAttribute('aria-invalid', 'true');
          titleEl.focus();
        }
        const err = document.getElementById('new-assign-title-error');
        if (err) err.style.display = 'flex';
        hasError = true;
      }

      if (!due) {
        if (dueEl) {
          dueEl.classList.add('has-error');
          dueEl.setAttribute('aria-invalid', 'true');
          if (!hasError) dueEl.focus();
        }
        const err = document.getElementById('new-assign-due-error');
        if (err) err.style.display = 'flex';
        hasError = true;
      }

      if (hasError) {
        showToast('Incomplete Form', 'Please fix the highlighted errors before publishing.', 'alert-circle');
        return;
      }

      const newAssignment = {
        id: 'assign-' + Date.now(),
        title: escapeHtml(title),
        cohort: escapeHtml(cohort),
        subject: escapeHtml(subject),
        due: escapeHtml(due),
        progress: 0,
        submissions: '0/36 submitted',
        badge: 'New'
      };

      // Prepend to array
      TEACHER_ASSIGNMENTS_DATA.unshift(newAssignment);
      renderAssignmentsList();

      // Reset form and close modal
      const formEl = document.getElementById('new-assignment-form');
      if (formEl) formEl.reset();
      closeNewAssignmentModal();

      // Success Confirmation State (Checklist A13)
      const banner = document.getElementById('assignment-success-banner');
      const bannerText = document.getElementById('assignment-success-text');
      if (banner) {
        if (bannerText) bannerText.textContent = `Assignment "${title}" published for ${cohort}. Roster updated.`;
        banner.style.display = 'flex';
        setTimeout(() => {
          if (banner) banner.style.display = 'none';
        }, 5500);
      }

      showToast('Assignment Published', `"${title}" assigned to ${cohort}.`, 'check-circle-2');
    }

    /* =========================================================================
       7. MODULE 5: BROADCASTS (COMPOSER & LIVE REAL-TIME FEED)
       ========================================================================= */
    function renderBroadcastsList() {
      const container = document.getElementById('announcements-feed-container');
      if (!container) return;
      container.innerHTML = '';

      BROADCASTS_DATA.forEach(bc => {
        const item = document.createElement('div');
        item.className = 'announcement-item';
        item.id = `bc-item-${bc.id}`;

        item.innerHTML = `
          <div class="announcement-header">
            <h4 class="announcement-headline">${escapeHtml(bc.headline)}</h4>
            <span class="badge badge-beige">${escapeHtml(bc.audience)}</span>
          </div>
          <div class="announcement-meta">
            <span><i data-lucide="user" style="width: 12px; height: 12px; display: inline-block; vertical-align: middle;" aria-hidden="true"></i> ${escapeHtml(bc.author)}</span>
            <span>·</span>
            <span><i data-lucide="clock" style="width: 12px; height: 12px; display: inline-block; vertical-align: middle;" aria-hidden="true"></i> ${escapeHtml(bc.time)}</span>
            <span>·</span>
            <span class="badge badge-sage" style="padding: 1px 6px; font-size: 10px;">${escapeHtml(bc.category)}</span>
          </div>
          <p class="announcement-body">${escapeHtml(bc.message)}</p>
        `;
        container.appendChild(item);
      });

      const countBadge = document.getElementById('broadcasts-count-badge');
      if (countBadge) countBadge.textContent = `${BROADCASTS_DATA.length} Published`;

      if (window.lucide) lucide.createIcons();
    }

    function clearBroadcastErrors() {
      const head = document.getElementById('broadcast-headline');
      const headErr = document.getElementById('broadcast-headline-error');
      const msg = document.getElementById('broadcast-message');
      const msgErr = document.getElementById('broadcast-message-error');
      if (head) { head.classList.remove('has-error'); head.removeAttribute('aria-invalid'); }
      if (headErr) headErr.style.display = 'none';
      if (msg) { msg.classList.remove('has-error'); msg.removeAttribute('aria-invalid'); }
      if (msgErr) msgErr.style.display = 'none';
    }

    function handlePublishBroadcast(e) {
      if (e) e.preventDefault();
      clearBroadcastErrors();

      const headlineEl = document.getElementById('broadcast-headline');
      const audienceEl = document.getElementById('broadcast-audience');
      const messageEl = document.getElementById('broadcast-message');

      const headline = headlineEl ? headlineEl.value.trim() : '';
      const audience = audienceEl ? audienceEl.value : 'XI Commerce';
      const message = messageEl ? messageEl.value.trim() : '';

      let hasError = false;

      // Real Form Validation (Checklist A12 & B9)
      if (!headline || headline.length < 4) {
        if (headlineEl) {
          headlineEl.classList.add('has-error');
          headlineEl.setAttribute('aria-invalid', 'true');
          headlineEl.focus();
        }
        const errEl = document.getElementById('broadcast-headline-error');
        if (errEl) errEl.style.display = 'flex';
        hasError = true;
      }

      if (!message || message.length < 10) {
        if (messageEl) {
          messageEl.classList.add('has-error');
          messageEl.setAttribute('aria-invalid', 'true');
          if (!hasError) messageEl.focus();
        }
        const errEl = document.getElementById('broadcast-message-error');
        if (errEl) errEl.style.display = 'flex';
        hasError = true;
      }

      if (hasError) {
        showToast('Incomplete Notice', 'Please resolve the highlighted validation errors.', 'alert-circle');
        return;
      }

      const now = new Date();
      const timeStr = `Today at ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;

      // Sanitize inputs (Checklist B9)
      const newBroadcast = {
        id: 'bc-' + Date.now(),
        headline: escapeHtml(headline),
        audience: escapeHtml(audience),
        author: STATE.currentUser ? escapeHtml(STATE.currentUser.name) : 'Aarav Mehta',
        time: timeStr,
        category: 'Notice',
        message: escapeHtml(message)
      };

      BROADCASTS_DATA.unshift(newBroadcast);
      renderBroadcastsList();

      // Highlight new item
      const firstEl = document.querySelector('.announcement-item');
      if (firstEl) firstEl.classList.add('newly-added');

      resetBroadcastForm();

      // Success Confirmation Banner & Toast (Checklist A13)
      const successBanner = document.getElementById('broadcast-success-banner');
      const successText = document.getElementById('broadcast-success-text');
      if (successBanner) {
        if (successText) successText.textContent = `Notice "${headline}" broadcast live to ${audience}.`;
        successBanner.style.display = 'flex';
        setTimeout(() => {
          if (successBanner) successBanner.style.display = 'none';
        }, 5500);
      }

      showToast('Broadcast Published', `Notice transmitted live to ${audience}.`, 'send');

      const statBc = document.getElementById('overview-stat-broadcasts');
      if (statBc) {
        statBc.textContent = String(parseInt(statBc.textContent || '0') + 1).padStart(2, '0');
      }
    }

    function resetBroadcastForm() {
      document.getElementById('broadcast-form').reset();
    }

