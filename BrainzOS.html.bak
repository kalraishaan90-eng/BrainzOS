        id: 'ecotrack',
        name: 'EcoTrack',
        founder: 'Myra Kapoor',
        category: 'Climate',
        status: 'Approved',
        mentor: 'Dr. Vikram Sethi (Environmental Sciences)',
        grant: '₹22,000 Sensor Allocation (Approved)',
        summary: 'Smart IoT campus energy dashboard tracking photovoltaic solar array yields and cafeteria compost conversion metrics in real time.',
        resources: 'Rooftop solar inverter API webhook & central lobby LED display feed'
      }
    ];

    function renderVenturesTable() {
      const tbody = document.getElementById('ventures-table-body');
      if (!tbody) return;

      tbody.innerHTML = '';

      let pendingCount = 0;

      VENTURES_DATA.forEach(v => {
        if (v.status === 'Pending') pendingCount++;

        const tr = document.createElement('tr');

        let statusBadge = '';
        let actionCell = '';

        if (v.status === 'Approved') {
          statusBadge = `<span class="badge badge-sage"><i data-lucide="check" aria-hidden="true" style="width: 12px; height: 12px;"></i> Approved</span>`;
          actionCell = `<span style="font-size: var(--text-xs); color: var(--color-sage); font-weight: 600; display: inline-flex; align-items: center; gap: 5px;"><i data-lucide="check-circle" aria-hidden="true" style="width: 16px; height: 16px;"></i> Active</span>`;
        } else if (v.status === 'Revision Requested') {
          statusBadge = `<span class="badge badge-warning-calm"><i data-lucide="alert-circle" aria-hidden="true" style="width: 12px; height: 12px;"></i> Revision</span>`;
          actionCell = `<button class="btn-secondary" style="padding: 6px 12px; font-size: var(--text-xs);" onclick="openVentureReviewModal('${v.id}')">Review</button>`;
        } else {
          statusBadge = `<span class="badge badge-beige"><i data-lucide="clock" aria-hidden="true" style="width: 12px; height: 12px;"></i> Pending</span>`;
          actionCell = `<button class="btn-secondary" style="padding: 6px 12px; font-size: var(--text-xs); border-color: var(--color-blue); color: var(--color-blue); font-weight: 600;" onclick="openVentureReviewModal('${v.id}')">Review</button>`;
        }

        tr.innerHTML = `
          <td>
            <div style="display: flex; align-items: center; gap: 10px;">
              <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(106, 142, 174, 0.12); color: var(--color-blue); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: var(--text-xs);">
                ${v.name.substring(0, 2).toUpperCase()}
              </div>
              <div>
                <strong style="font-size: var(--text-sm); display: block; color: var(--color-ink);">${v.name}</strong>
                <span style="font-size: var(--text-xs); color: var(--color-ink-subtle);">${v.resources.slice(0, 36)}…</span>
              </div>
            </div>
          </td>
          <td style="font-weight: 500;">${v.founder}</td>
          <td>
            <span class="badge badge-blue">${v.category}</span>
          </td>
          <td>${statusBadge}</td>
          <td style="text-align: right;">${actionCell}</td>
        `;
        tbody.appendChild(tr);
      });

      // Update badge in top-line card and header
      const queueBadge = document.getElementById('venture-queue-badge');
      if (queueBadge) queueBadge.textContent = `${pendingCount} Pending Review`;
      const statPill = document.getElementById('stat-pending-ventures-pill');
      if (statPill) statPill.textContent = `${pendingCount} Awaiting Review`;

      if (window.lucide) lucide.createIcons();
    }

    function openVentureReviewModal(ventureId) {
      const venture = VENTURES_DATA.find(v => v.id === ventureId);
      if (!venture) return;

      STATE.activeReviewVentureId = ventureId;

      document.getElementById('venture-modal-title').textContent = `${venture.name} — Review Proposal`;
      document.getElementById('venture-modal-founder').textContent = venture.founder;
      document.getElementById('venture-modal-category').textContent = venture.category;
      document.getElementById('venture-modal-mentor').textContent = venture.mentor;
      document.getElementById('venture-modal-grant').textContent = venture.grant;
      document.getElementById('venture-modal-summary').textContent = venture.summary;
      document.getElementById('venture-modal-resources').textContent = venture.resources;

      document.getElementById('venture-modal-overlay').classList.add('active');
    }

    function closeVentureModal() {
      document.getElementById('venture-modal-overlay').classList.remove('active');
      STATE.activeReviewVentureId = null;
    }

    function approveCurrentVenture() {
      if (!STATE.activeReviewVentureId) return;
      const venture = VENTURES_DATA.find(v => v.id === STATE.activeReviewVentureId);
      if (!venture) return;

      venture.status = 'Approved';
      closeVentureModal();
      renderVenturesTable();

      logAuditEvent('Dr. Rhea Sharma', `Approved Student Venture: ${venture.name}`, 'Admin Console');
      showToast('Venture Approved', `${venture.name} has been endorsed for campus operations.`);
    }

    function rejectCurrentVenture() {
      if (!STATE.activeReviewVentureId) return;
      const venture = VENTURES_DATA.find(v => v.id === STATE.activeReviewVentureId);
      if (!venture) return;

      venture.status = 'Revision Requested';
      closeVentureModal();
      renderVenturesTable();

      logAuditEvent('Dr. Rhea Sharma', `Requested Revision for Venture: ${venture.name}`, 'Admin Console');
      showToast('Revision Requested', `${venture.founder} notified to refine incubator application.`);
    }

    /* =========================================================================
       4. SCHOOL-WIDE FEED DATA & CONTROLLER
       ========================================================================= */
    const SCHOOL_FEED = [
      {
        id: 'f-1',
        category: 'Operations',
        headline: 'Morning systems check completed successfully.',
        details: 'Facility automation, smartboard power clusters, and perimeter security telemetry validated across all Senior Secondary wings.',
        time: '07:30 IST',
        author: 'Campus Operations',
        badgeClass: 'operations',
        icon: 'wrench'
      },
      {
        id: 'f-2',
        category: 'Academics',
        headline: 'Assessment moderation window opens today.',
        details: 'Department heads and senior secondary evaluators may submit verified Term I coursework marks through the faculty portal.',
        time: '08:45 IST',
        author: 'Office of Academic Affairs',
        badgeClass: 'academics',
        icon: 'book-open'
      },
      {
        id: 'f-3',
        category: 'Student Life',
        headline: 'Inter-house sports registration is open.',
        details: 'Cohort registrations for Athletics, Badminton, and Chess tournaments can now be coordinated with respective house captains.',
        time: '10:15 IST',
        author: 'Athletics & Physical Education',
        badgeClass: 'student-life',
        icon: 'trophy'
      },
      {
        id: 'f-4',
        category: 'IT',
        headline: 'BrainzOS maintenance window scheduled.',
        details: 'Routine database indexing scheduled for Sunday, 02:00–03:00 IST. High-availability cluster ensures zero student pass downtime.',
        time: '11:30 IST',
        author: 'IT Infrastructure Team',
        badgeClass: 'it',
        icon: 'cpu'
      }
    ];

    let currentFeedFilter = 'all';

    function renderFeed() {
      const container = document.getElementById('feed-items-container');
      if (!container) return;

      container.innerHTML = '';

      const filtered = SCHOOL_FEED.filter(item => {
        if (currentFeedFilter === 'all') return true;
        return item.category.toLowerCase() === currentFeedFilter.toLowerCase();
      });

      // Update counters
      if (document.getElementById('feed-count-all')) document.getElementById('feed-count-all').textContent = SCHOOL_FEED.length;
      document.getElementById('count-operations').textContent = SCHOOL_FEED.filter(i => i.category === 'Operations').length;
      document.getElementById('count-academics').textContent = SCHOOL_FEED.filter(i => i.category === 'Academics').length;
      document.getElementById('count-student-life').textContent = SCHOOL_FEED.filter(i => i.category === 'Student Life').length;
      document.getElementById('count-it').textContent = SCHOOL_FEED.filter(i => i.category === 'IT').length;

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="card card-flat" style="text-align: center; padding: 40px; color: var(--color-ink-subtle);">
            No feed items found under category "${currentFeedFilter}".
          </div>
        `;
        return;
      }

      filtered.forEach(item => {
        const card = document.createElement('div');
        card.className = 'feed-item-card';

        let badgeType = 'badge-blue';
        if (item.category === 'Academics') badgeType = 'badge-sage';
        if (item.category === 'Student Life') badgeType = 'badge-beige';
        if (item.category === 'IT') badgeType = 'badge-blue';

        card.innerHTML = `
          <div class="feed-cat-icon ${item.badgeClass || 'operations'}">
            <i data-lucide="${item.icon || 'bell'}" aria-hidden="true" style="width: 20px; height: 20px;"></i>
          </div>
          <div class="feed-content">
            <div class="feed-header-meta">
              <span class="badge ${badgeType}">${item.category}</span>
              <span style="font-size: var(--text-xs); color: var(--color-ink-subtle);">${item.author}</span>
              <span style="font-size: var(--text-xs); color: var(--color-ink-subtle);">·</span>
              <span style="font-size: var(--text-xs); color: var(--color-ink-subtle); font-family: monospace;">${item.time}</span>
            </div>
            <div class="feed-title">${item.headline}</div>
            <p class="feed-subtext">${item.details}</p>
          </div>
        `;
        container.appendChild(card);
      });

      if (window.lucide) lucide.createIcons();
    }

    function filterFeed(category, btnEl) {
      currentFeedFilter = category;
      document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
      if (btnEl) btnEl.classList.add('active');
      renderFeed();
    }

    function openNewNoticeModal() {
      document.getElementById('notice-headline').value = '';
      document.getElementById('notice-body').value = '';
      document.getElementById('notice-modal-overlay').classList.add('active');
    }

    function closeNewNoticeModal() {
      document.getElementById('notice-modal-overlay').classList.remove('active');
    }

    function submitNewNotice() {
      const category = document.getElementById('notice-category').value;
      const headline = document.getElementById('notice-headline').value.trim();
      const body = document.getElementById('notice-body').value.trim();

      if (!headline || !body) {
        alert('Please provide both a headline and content for the announcement.');
        return;
      }

      const now = new Date();
      const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ' IST';

      let icon = 'bell';
      let badgeClass = 'operations';
      if (category === 'Academics') { icon = 'book-open'; badgeClass = 'academics'; }
      if (category === 'Student Life') { icon = 'trophy'; badgeClass = 'student-life'; }
      if (category === 'IT') { icon = 'cpu'; badgeClass = 'it'; }

      const newEntry = {
        id: 'f-' + Date.now(),
        category: category,
        headline: headline,
        details: body,
        time: timeStr,
        author: 'Dr. Rhea Sharma (Director)',
        badgeClass: badgeClass,
        icon: icon
      };

      SCHOOL_FEED.unshift(newEntry);
      closeNewNoticeModal();
      renderFeed();

      logAuditEvent('Dr. Rhea Sharma', `Published school-wide notice (${category}): "${headline.substring(0, 30)}…"`, 'Admin Console');
      showToast('Announcement Published', 'Dispatched live across campus channels.');
    }

    /* =========================================================================
       5. EMERGENCY BROADCAST CONTROL ENGINE
       ========================================================================= */
    function openEmergencyModal() {
      document.getElementById('emergency-confirm-input').value = '';
      document.getElementById('emergency-confirm-btn').disabled = true;
      document.getElementById('emergency-modal-overlay').classList.add('active');
    }

    function closeEmergencyModal() {
      document.getElementById('emergency-modal-overlay').classList.remove('active');
    }

    function checkEmergencyConfirmTyping() {
      const val = document.getElementById('emergency-confirm-input').value.trim();
      const btn = document.getElementById('emergency-confirm-btn');
      btn.disabled = (val.toUpperCase() !== 'CONFIRM');
    }

    function confirmAndTriggerSiren() {
      const type = document.getElementById('emergency-type-select').value;
      closeEmergencyModal();

      STATE.emergencyActive = true;
      const banner = document.getElementById('emergency-active-banner');
      if (banner) {
        banner.classList.add('active');
        document.getElementById('active-siren-meta').textContent = 
          `Protocol: ${type} · Transmitted to 348 classroom endpoints · Ledger updated`;
      }

      logAuditEvent('Dr. Rhea Sharma', `Activated Emergency Siren Broadcast (${type})`, 'Admin Console');
      showToast('Emergency Siren Activated', `Broadcast override active for: ${type}`);
    }

    function deactivateEmergencySiren() {
      STATE.emergencyActive = false;
      const banner = document.getElementById('emergency-active-banner');
      if (banner) banner.classList.remove('active');

      logAuditEvent('Dr. Rhea Sharma', 'Stood down Emergency Siren Broadcast', 'Admin Console');
      showToast('Emergency Stand Down', 'All campus endpoints returned to standard operational state.');
    }

    function runSilentDiagnosticTest() {
      const resultBox = document.getElementById('silent-test-results');
      const details = document.getElementById('silent-test-details');
      
      const latency = Math.floor(Math.random() * 8) + 11; // 11-18ms
      details.textContent = `348/348 endpoints acknowledged in ${latency}ms. Zero audio emissions verified. Handshake clean.`;
      
      resultBox.style.display = 'block';

      logAuditEvent('Dr. Rhea Sharma', `Executed Silent Emergency Beacon Diagnostic Test (${latency}ms)`, 'Admin Console');
      showToast('Silent Diagnostic Test Passed', `348 nodes verified in ${latency}ms.`);
    }

    /* =========================================================================
       6. EXECUTIVE ANALYTICS ANIMATION & ACTIONS
       ========================================================================= */
    function animateDepartmentBars() {
      const bars = document.querySelectorAll('.dept-progress-bar');
      bars.forEach(bar => {
        const val = bar.getAttribute('data-value') || '0%';
        bar.style.width = '0%';
        setTimeout(() => {
          bar.style.width = val;
        }, 120);
      });
    }

    function refreshAnalyticsMetrics() {
      const studentsEl = document.getElementById('stat-students-online');
      
      const randomStudents = 1280 + Math.floor(Math.random() * 12);
      studentsEl.textContent = randomStudents.toLocaleString();

      animateDepartmentBars();
      logAuditEvent('Dr. Rhea Sharma', 'Synchronized real-time institutional metrics', 'Admin Console');
      showToast('Metrics Synchronized', 'Telemetry refreshed from campus identity cluster.');
    }

    function exportExecutiveSummary() {
      logAuditEvent('Dr. Rhea Sharma', 'Generated Term I Board of Trustees Executive Summary', 'Admin Console');
      showToast('Report Generated', 'Executive summary packet generated successfully.');
    }


    /* =========================================================================
       WINDOW EVENT LISTENERS & RUNTIME INITIALIZATION
       ========================================================================= */
    window.addEventListener('DOMContentLoaded', () => {
      // Initialize Cookie & Session Notice Banner (Checklist A15)
      initCookieBanner();

      // Enforce Unauthenticated Route Guard on Initial Page Load (Checklist B10)
      if (!STATE.currentUser) {
        const loginViewport = document.getElementById('login-viewport');
        const appViewport = document.getElementById('app-viewport');
        if (loginViewport) loginViewport.classList.remove('hidden-view');
        if (appViewport) appViewport.classList.remove('active-view');
        if (window.location.hash) {
          history.replaceState(null, null, ' ');
        }
      }

      // Email input live detection & clear validation error
      const emailInput = document.getElementById('school-email');
      if (emailInput) {
        emailInput.addEventListener('input', (e) => {
          clearLoginError();
          const detectedRole = detectRoleFromEmail(e.target.value);
          updateRoleIndicatorUI(detectedRole);
        });
      }

      // Command palette input typing
      if (cmdInput) {
        cmdInput.addEventListener('input', (e) => {
          STATE.cmdSelectedIndex = 0;
          filterCommandResults(e.target.value);
        });
      }

      // Keyboard shortcuts
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (cmdOverlay && cmdOverlay.classList.contains('active')) {
            closeCommandLauncher();
          } else {
            openCommandLauncher();
          }
        } else if (e.key === 'Escape') {
          if (cmdOverlay && cmdOverlay.classList.contains('active')) {
            closeCommandLauncher();
          }
          const openModals = document.querySelectorAll('.modal-overlay.active, .biometric-overlay.active');
          openModals.forEach(m => m.classList.remove('active'));
        } else if (cmdOverlay && cmdOverlay.classList.contains('active')) {
          const items = cmdResultsList ? cmdResultsList.querySelectorAll('.cmd-item') : [];
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            STATE.cmdSelectedIndex = (STATE.cmdSelectedIndex + 1) % items.length;
            highlightCmdItem(items);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            STATE.cmdSelectedIndex = (STATE.cmdSelectedIndex - 1 + items.length) % items.length;
            highlightCmdItem(items);
          } else if (e.key === 'Enter') {
            e.preventDefault();
            const selected = items[STATE.cmdSelectedIndex];
            if (selected) selected.click();
          }
        }
      });

      // Global timetable ticker (ticks every 1s)
      setInterval(() => {
        if (typeof timetableDetectionMode !== 'undefined' && timetableDetectionMode === 'sim') {
          if (typeof simulatedSecondTicker !== 'undefined') {
            if (simulatedSecondTicker > 0) {
              simulatedSecondTicker--;
            } else {
              simulatedSecondTicker = 50 * 60;
            }
          }
        }
        if (STATE.currentUser && STATE.currentUser.role === 'student' && typeof updateTimetableState === 'function') {
          updateTimetableState();
        }
      }, 1000);

      // Render Lucide icons
      if (window.lucide) {
        lucide.createIcons();
      }
    });


  </script>
</body>
</html>
