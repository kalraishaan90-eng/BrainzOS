</div>
</div>
<button class="btn-secondary" onclick="deactivateEmergencySiren()" style="border-color: rgba(186, 104, 104, 0.4); background: #FFFFFF;">
<i data-lucide="square" aria-hidden="true" style="width: 15px; height: 15px; color: #BA6868;"></i>
<span>Deactivate / Stand Down</span>
</button>
</div>
<!-- Restricted Console Station Container -->
<div class="emergency-station">
<div class="emergency-badge">
<i data-lucide="lock" aria-hidden="true" style="width: 13px; height: 13px;"></i>
<span>Restricted Protocol · Tier 1 Directorial Clearance</span>
</div>
<h2 style="font-size: 1.75rem; margin-bottom: 12px; letter-spacing: -0.02em;">Emergency Broadcast Control</h2>
<p style="font-size: var(--text-base); line-height: 1.6; max-width: 860px; margin-bottom: 12px;">
              This control is used for verified campus-wide emergencies. Activating this protocol sends an immediate high-priority alert override across authorized school devices, classroom interactive boards, staff portals, and PA systems. Every activation is logged with an immutable timestamp in the institutional audit ledger.
            </p>
<div style="padding: 12px 16px; border-radius: var(--radius-md); background: rgba(212, 201, 183, 0.28); border: 1px solid var(--color-border-warm); font-size: var(--text-xs); color: #615543; line-height: 1.5; margin-bottom: 24px;">
<strong>DEMO ONLY:</strong> This control station operates in demonstration mode — it does not contact real emergency systems or physical city sirens. All activations and silent tests are recorded in the local Audit Logs list for simulation and review.
            </div>
<!-- Two Distinct Trigger Actions -->
<div class="emergency-grid">
<!-- Action 1: Activate Emergency Siren -->
<div class="emergency-action-card siren-danger">
<div>
<div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
<div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(186, 104, 104, 0.15); color: #BA6868; display: flex; align-items: center; justify-content: center;">
<i data-lucide="alert-triangle" aria-hidden="true" style="width: 18px; height: 18px;"></i>
</div>
<h3 style="font-size: 1.25rem;">Activate Emergency Siren</h3>
</div>
<p style="font-size: var(--text-sm); line-height: 1.55;">
                    Initiates high-priority campus warning tone, locks non-essential student devices, and projects emergency evacuation protocol cards onto all classroom screens.
                  </p>
<div style="margin-top: 12px; font-size: 0.75rem; color: #9c4545; font-weight: 600;">
                    Requires directorial confirmation modal before activation.
                  </div>
</div>
<div>
<button class="btn-danger-calm" onclick="openEmergencyModal()" style="width: 100%; justify-content: center;">
<i data-lucide="radio" aria-hidden="true" style="width: 17px; height: 17px;"></i>
<span>Activate Emergency Siren</span>
</button>
</div>
</div>
<!-- Action 2: Run Silent Test -->
<div class="emergency-action-card">
<div>
<div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
<div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(106, 142, 174, 0.12); color: var(--color-blue); display: flex; align-items: center; justify-content: center;">
<i data-lucide="activity" aria-hidden="true" style="width: 18px; height: 18px;"></i>
</div>
<h3 style="font-size: 1.25rem;">Run Silent Test</h3>
</div>
<p style="font-size: var(--text-sm); line-height: 1.55;">
                    Executes non-audible diagnostic telemetry handshake across all 348 registered classroom endpoints. Validates receiver response time without producing sound.
                  </p>
<div style="margin-top: 12px; font-size: 0.75rem; color: var(--color-ink-subtle); font-weight: 600;">
                    Immediate execution · Zero student distraction · Logs to audit trail
                  </div>
</div>
<div>
<button class="btn-secondary" onclick="runSilentDiagnosticTest()" style="width: 100%; justify-content: center;">
<i data-lucide="check-circle-2" aria-hidden="true" style="width: 17px; height: 17px; color: var(--color-sage);"></i>
<span>Run Silent Test</span>
</button>
</div>
</div>
</div>
<!-- Silent Test Diagnostic Feedback Result (Hidden until run) -->
<div id="silent-test-results" style="display: none; margin-top: 24px; padding: 18px 22px; border-radius: var(--radius-md); background: rgba(158, 187, 175, 0.16); border: 1px solid rgba(158, 187, 175, 0.38);">
<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
<div style="display: flex; align-items: center; gap: 12px;">
<i data-lucide="check-circle" aria-hidden="true" style="width: 22px; height: 22px; color: var(--color-sage);"></i>
<div>
<strong style="font-size: var(--text-sm); color: #2e4d3f; display: block;">Silent Telemetry Ping Succeeded</strong>
<span id="silent-test-details" style="font-size: var(--text-xs); color: #436959;">348/348 endpoints acknowledged in 14ms. Event committed to Audit Logs.</span>
</div>
</div>
<button class="btn-secondary" onclick="navigateTo('page-director-audit')" style="padding: 6px 12px; font-size: var(--text-xs);">
<span>View in Audit Logs</span>
<i data-lucide="arrow-right" aria-hidden="true" style="width: 14px; height: 14px;"></i>
</button>
</div>
</div>
</div>
</section>

<section class="os-page" id="page-director-feed">
<div class="page-header">
<div class="page-header-text">
<span class="eyebrow">Campus Communications &amp; Announcements</span>
<h1>School-Wide Feed</h1>
<p>Live centralized operational stream across facility operations, academic administration, student life, and IT infrastructure.</p>
</div>
<div class="page-header-actions">
<button class="btn-primary" onclick="openNewNoticeModal()" style="width: auto;">
<i data-lucide="plus" aria-hidden="true" style="width: 16px; height: 16px;"></i>
<span>Publish Announcement</span>
</button>
</div>
</div>
<!-- Filter categories -->
<div class="feed-filter-bar">
<button class="filter-btn active" data-filter="all" onclick="filterFeed('all', this)">All Dispatches (<span id="feed-count-all">4</span>)</button>
<button class="filter-btn" data-filter="Operations" onclick="filterFeed('Operations', this)">Operations (<span id="count-operations">1</span>)</button>
<button class="filter-btn" data-filter="Academics" onclick="filterFeed('Academics', this)">Academics (<span id="count-academics">1</span>)</button>
<button class="filter-btn" data-filter="Student Life" onclick="filterFeed('Student Life', this)">Student Life (<span id="count-student-life">1</span>)</button>
<button class="filter-btn" data-filter="IT" onclick="filterFeed('IT', this)">IT Systems (<span id="count-it">1</span>)</button>
</div>
<!-- Dynamic Feed Container -->
<div class="feed-container" id="feed-items-container">
<!-- Populated dynamically via JS -->
</div>
</section>

<section class="os-page" id="page-director-ventures">
<div class="page-header">
<div class="page-header-text">
<span class="eyebrow">Student Enterprise &amp; Incubation Cell</span>
<h1>Venture Approvals</h1>
<p>Formal directorate review queue for student startups, micro-ventures, and institutional resource allocations.</p>
</div>
<div class="page-header-actions">
<div class="badge badge-blue" id="venture-queue-badge">2 Pending Review</div>
</div>
</div>
<div class="card" style="padding: 0; overflow: hidden;">
<div class="table-container">
<table id="ventures-table">
<thead>
<tr>
<th>Venture</th>
<th>Founder</th>
<th>Category</th>
<th>Status</th>
<th style="text-align: right;">Action</th>
</tr>
</thead>
<tbody id="ventures-table-body">
<!-- Rendered dynamically from VENTURES_DATA array -->
</tbody>
</table>
</div>
</div>
</section>

<section class="os-page" id="page-director-audit">
<div class="page-header">
<div class="page-header-text">
<span class="eyebrow">Regulatory Compliance &amp; Security</span>
<h1>Audit Logs</h1>
<p>Chronological immutable record of security events, administrative endorsements, emergency broadcast tests, and authentication rotations.</p>
</div>
<div class="page-header-actions">
<button class="btn-secondary" onclick="exportAuditLogsCSV()">
<i data-lucide="file-spreadsheet" aria-hidden="true" style="width: 16px; height: 16px;"></i>
<span>Export Audit CSV</span>
</button>
<button class="btn-secondary" onclick="renderAuditLogsTable()">
<i data-lucide="refresh-cw" aria-hidden="true" style="width: 16px; height: 16px;"></i>
<span>Refresh Logs</span>
</button>
</div>
</div>
<!-- Quick Filter / Search within Audit Logs -->
<div class="card card-flat" style="padding: 16px 20px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
<div style="display: flex; align-items: center; gap: 10px; flex: 1; min-width: 260px;">
<i data-lucide="filter" aria-hidden="true" style="width: 16px; height: 16px; color: var(--color-ink-subtle);"></i>
<input id="audit-filter-input" oninput="handleAuditSearch(event)" placeholder="Filter logs by actor, action keyword, or device…" style="background: transparent; border: none; width: 100%; font-size: var(--text-sm);" type="text"/>
</div>
<div id="audit-count-indicator" style="font-size: var(--text-xs); color: var(--color-ink-subtle);">
              Showing 6 entries · Session in-memory ledger
            </div>
</div>
<!-- Audit Logs Table -->
<div class="card" style="padding: 0; overflow: hidden;">
<div class="table-container">
<table>
<thead>
<tr>
<th style="width: 120px;">Time</th>
<th style="width: 180px;">Actor</th>
<th>Action</th>
<th style="width: 180px;">Device / Service</th>
<th style="width: 90px; text-align: right;">State</th>
</tr>
</thead>
<tbody id="audit-logs-table-body">
<!-- Populated in real time from AUDIT_LOGS array -->
</tbody>
</table>
</div>
</div>
</section>
      </main>
    </div>
  </div>

  <!-- =======================================================================
       3. MODALS, OVERLAYS & DIALOGS
       ======================================================================= -->

  <div class="cmd-overlay" id="cmd-overlay" onclick="handleCmdOverlayClick(event)">
<div class="cmd-palette" id="cmd-palette">
