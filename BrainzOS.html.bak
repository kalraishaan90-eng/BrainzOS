            <p class="pitch-desc">${v.desc}</p>

            <div class="pitch-tags">
              ${v.tags.map(t => `<span class="pitch-tag">${t}</span>`).join('')}
            </div>
          </div>

          <div class="pitch-action-row">
            <!-- Upvote Button with live counter -->
            <button class="vote-btn ${v.hasVoted ? 'voted' : ''}" onclick="togglePitchVote('${v.id}')">
              <i data-lucide="arrow-big-up" aria-hidden="true" style="width: 17px; height: 17px;"></i>
              <span>${v.votes}</span>
            </button>

            <!-- Working Director's Pick Demo Toggle -->
            <div class="toggle-switch-wrap ${v.isDirectorsPick ? 'active' : ''}" onclick="toggleDirectorsPick('${v.id}')" title="Toggle Director's Pick badge">
              <span class="toggle-switch-label">Director's Pick</span>
              <div class="toggle-switch-track">
                <div class="toggle-switch-knob"></div>
              </div>
            </div>
          </div>
        </div>
      `).join('');

      if (window.lucide) lucide.createIcons();
    }

