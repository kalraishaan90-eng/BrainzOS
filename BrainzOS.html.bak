<i data-lucide="search" aria-hidden="true" style="width: 18px; height: 18px; color: var(--color-ink-subtle);"></i>
<input autocomplete="off" class="cmd-search-input" id="cmd-input" placeholder="Type a page name, destination, or command…" type="text"/>
<kbd class="cmd-kbd-badge">ESC</kbd>
</div>
<div class="cmd-results" id="cmd-results-list">
<!-- Rendered dynamically from current role's navigable pages -->
</div>
<div class="cmd-footer">
<div class="cmd-hints">
<span><kbd class="cmd-kbd-badge">↑</kbd> <kbd class="cmd-kbd-badge">↓</kbd> Navigate</span>
<span><kbd class="cmd-kbd-badge">↵</kbd> Select</span>
</div>
<span>BrainzOS Core Shell</span>
</div>
</div>
</div>
  <div class="biometric-overlay" id="biometric-overlay">
<div class="biometric-modal">
<div class="bio-sensor-ring" id="bio-sensor-ring">
<div class="bio-laser-beam" id="bio-laser"></div>
<i class="bio-icon" data-lucide="fingerprint" id="bio-icon-scan"></i>
<i class="bio-success-icon" data-lucide="check-circle-2" id="bio-icon-check"></i>
</div>
<h3 class="bio-status-title" id="bio-status-title">Institutional Biometrics</h3>
<p class="bio-status-desc" id="bio-status-desc">Scanning registered hardware key &amp; credentials…</p>
</div>
</div>
  <div class="modal-overlay" id="new-assignment-modal" onclick="handleAssignmentModalOverlayClick(event)">
<div class="modal-dialog">
<div class="modal-header">
<div style="display: flex; align-items: center; gap: 10px;">
<div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(106, 142, 174, 0.14); display: flex; align-items: center; justify-content: center; color: var(--color-blue);">
<i data-lucide="file-plus" aria-hidden="true" style="width: 17px; height: 17px;"></i>
</div>
<div>
<h3 style="font-size: 1.2rem; font-weight: 600;">Create New Assignment</h3>
<p class="subtext">Configure parameters and schedule due dates</p>
</div>
</div>
<button class="modal-close-btn" onclick="closeNewAssignmentModal()" aria-label="Close dialog">
<i data-lucide="x" aria-hidden="true" style="width: 18px; height: 18px;"></i>
</button>
</div>
<form id="new-assignment-form" novalidate onsubmit="handleCreateAssignment(event)">
<div class="form-group">
<label class="form-label" for="new-assign-title">Assignment Title</label>
<input class="composer-input" id="new-assign-title" placeholder="e.g., Fiscal Deficit &amp; Monetary Dynamics Case Study" required="" type="text" aria-describedby="new-assign-title-error" oninput="clearAssignmentErrors()"/>
<div class="form-field-error" id="new-assign-title-error" style="display: none;" role="alert">
  <i data-lucide="alert-circle" style="width: 14px; height: 14px;" aria-hidden="true"></i>
  <span>Assignment title must be at least 4 characters long.</span>
</div>
</div>
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
<div class="form-group">
<label class="form-label" for="new-assign-class">Cohort Class</label>
<select class="composer-select" id="new-assign-class" required="">
<option value="XI-B Commerce">XI-B Commerce</option>
<option value="XI-A Commerce">XI-A Commerce</option>
<option value="XII-A Commerce">XII-A Commerce</option>
</select>
</div>
<div class="form-group">
<label class="form-label" for="new-assign-subject">Subject</label>
<select class="composer-select" id="new-assign-subject" required="">
<option value="Political Science">Political Science</option>
<option value="Economics">Economics</option>
<option value="Business Studies">Business Studies</option>
</select>
</div>
</div>
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
<div class="form-group">
<label class="form-label" for="new-assign-due">Due Date</label>
<input class="composer-input" id="new-assign-due" placeholder="e.g., Tomorrow or Sep 28" required="" type="text" aria-describedby="new-assign-due-error" oninput="clearAssignmentErrors()"/>
<div class="form-field-error" id="new-assign-due-error" style="display: none;" role="alert">
  <i data-lucide="alert-circle" style="width: 14px; height: 14px;" aria-hidden="true"></i>
  <span>Submission deadline date is required.</span>
</div>
</div>
<div class="form-group">
<label class="form-label" for="new-assign-marks">Max Evaluation Score</label>
<input class="composer-input" id="new-assign-marks" max="100" min="10" required="" type="number" value="40"/>
</div>
</div>
<div class="form-group">
<label class="form-label" for="new-assign-desc">Brief Instructions</label>
<textarea class="composer-textarea" id="new-assign-desc" placeholder="Outline rubric parameters or submission portal guidelines..." style="min-height: 80px;"></textarea>
</div>
<div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
<button class="btn-secondary" onclick="closeNewAssignmentModal()" type="button" aria-label="Cancel assignment creation">Cancel</button>
<button class="btn-primary" type="submit" aria-label="Confirm and publish assignment">
<i data-lucide="check" style="width: 16px; height: 16px;" aria-hidden="true"></i>
<span>Add Assignment</span>
</button>
</div>
</form>
</div>
</div>
  <div class="modal-overlay" id="emergency-modal-overlay">
<div class="modal-window">
<div class="modal-header">
<div style="display: flex; align-items: center; gap: 10px;">
<div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(186, 104, 104, 0.15); color: #BA6868; display: flex; align-items: center; justify-content: center;">
<i data-lucide="alert-octagon" aria-hidden="true" style="width: 20px; height: 20px;"></i>
</div>
<div>
<h3 style="font-size: 1.25rem;">Confirm Emergency Broadcast</h3>
<span style="font-size: var(--text-xs); color: var(--color-ink-subtle);">Directorial Override Authorization</span>
</div>
</div>
<button class="modal-close-btn" onclick="closeEmergencyModal()" aria-label="Close dialog">
<i data-lucide="x" aria-hidden="true" style="width: 18px; height: 18px;"></i>
</button>
</div>
<div style="margin-bottom: 20px; font-size: var(--text-sm); line-height: 1.55; color: var(--color-ink-muted);">
        You are about to transmit a high-priority emergency broadcast across <strong>348 connected campus endpoints</strong> (smartboards, teacher stations, and institutional channels).
      </div>
<div class="form-group">
<label class="form-label" for="emergency-type-select">Emergency Incident Type</label>
<select id="emergency-type-select" style="width: 100%; padding: 12px 14px; border-radius: var(--radius-md); background: rgba(248, 244, 237, 0.6); border: 1px solid var(--color-border-warm);">
<option value="Severe Weather Protocol (Code Yellow)">Severe Weather Protocol (Code Yellow)</option>
<option value="Campus Evacuation Drill (Code Blue)">Campus Evacuation Drill (Code Blue)</option>
<option value="Full Facility Lockdown (Code Red)">Full Facility Lockdown (Code Red)</option>
<option value="Medical Dispatch Priority Alert">Medical Dispatch Priority Alert</option>
</select>
</div>
<div class="form-group" style="margin-bottom: 24px;">
<label class="form-label" for="emergency-confirm-input">Type "CONFIRM" to authorize broadcast</label>
<input id="emergency-confirm-input" oninput="checkEmergencyConfirmTyping()" placeholder="CONFIRM" style="width: 100%; padding: 12px 14px; border-radius: var(--radius-md); font-weight: 600; letter-spacing: 0.05em;" type="text"/>
</div>
<div style="display: flex; gap: 12px; justify-content: flex-end;">
<button class="btn-secondary" onclick="closeEmergencyModal()">Cancel</button>
<button class="btn-danger-calm" disabled="" id="emergency-confirm-btn" onclick="confirmAndTriggerSiren()">
<i data-lucide="bell" aria-hidden="true" style="width: 16px; height: 16px;"></i>
<span>Authorize &amp; Activate Siren</span>
</button>
</div>
</div>
</div>
  <div class="modal-overlay" id="venture-modal-overlay">
<div class="modal-window" style="max-width: 580px;">
<div class="modal-header">
<div style="display: flex; align-items: center; gap: 12px;">
<div style="width: 40px; height: 40px; border-radius: 12px; background: rgba(106, 142, 174, 0.14); color: var(--color-blue); display: flex; align-items: center; justify-content: center;">
<i data-lucide="rocket" aria-hidden="true" style="width: 20px; height: 20px;"></i>
</div>
<div>
<h3 id="venture-modal-title" style="font-size: 1.35rem;">Venture Proposal Review</h3>
<span id="venture-modal-subtitle" style="font-size: var(--text-xs); color: var(--color-ink-subtle);">Student Incubation Directorate</span>
</div>
</div>
<button class="modal-close-btn" onclick="closeVentureModal()" aria-label="Close dialog">
<i data-lucide="x" aria-hidden="true" style="width: 18px; height: 18px;"></i>
</button>
</div>
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 18px; padding: 14px; border-radius: var(--radius-md); background: rgba(248, 244, 237, 0.65); border: 1px solid var(--color-border-subtle);">
<div>
<span style="font-size: 0.7rem; text-transform: uppercase; color: var(--color-ink-subtle); font-weight: 600; display: block;">Founder</span>
<strong id="venture-modal-founder" style="font-size: var(--text-sm);">—</strong>
</div>
<div>
<span style="font-size: 0.7rem; text-transform: uppercase; color: var(--color-ink-subtle); font-weight: 600; display: block;">Category</span>
<span class="badge badge-blue" id="venture-modal-category">—</span>
</div>
<div>
<span style="font-size: 0.7rem; text-transform: uppercase; color: var(--color-ink-subtle); font-weight: 600; display: block;">Faculty Mentor</span>
<span id="venture-modal-mentor" style="font-size: var(--text-sm); color: var(--color-ink-muted);">—</span>
</div>
<div>
<span style="font-size: 0.7rem; text-transform: uppercase; color: var(--color-ink-subtle); font-weight: 600; display: block;">Grant Request</span>
<span id="venture-modal-grant" style="font-size: var(--text-sm); font-weight: 600; color: var(--color-ink);">—</span>
</div>
</div>
<div style="margin-bottom: 16px;">
<span style="font-size: var(--text-xs); text-transform: uppercase; color: var(--color-ink-subtle); font-weight: 600; display: block; margin-bottom: 4px;">Executive Summary</span>
<p id="venture-modal-summary" style="font-size: var(--text-sm); line-height: 1.55; color: var(--color-ink); background: #FFFFFF; padding: 12px; border-radius: var(--radius-md); border: 1px solid var(--color-border-subtle);">
          —
        </p>
</div>
<div style="margin-bottom: 24px;">
<span style="font-size: var(--text-xs); text-transform: uppercase; color: var(--color-ink-subtle); font-weight: 600; display: block; margin-bottom: 4px;">Campus Resources Requested</span>
<div id="venture-modal-resources" style="font-size: var(--text-sm); color: var(--color-ink-muted);">
          —
        </div>
</div>
<div style="display: flex; gap: 10px; justify-content: flex-end;">
<button class="btn-secondary" onclick="closeVentureModal()">Close</button>
<button class="btn-secondary" onclick="rejectCurrentVenture()" style="border-color: rgba(212, 160, 80, 0.4); color: #835928;">
<i data-lucide="corner-up-left" aria-hidden="true" style="width: 15px; height: 15px;"></i>
<span>Request Revision</span>
</button>
<button class="btn-sage" onclick="approveCurrentVenture()">
<i data-lucide="check" aria-hidden="true" style="width: 16px; height: 16px;"></i>
<span>Approve Venture</span>
</button>
</div>
</div>
</div>
  <div class="modal-overlay" id="notice-modal-overlay">
<div class="modal-window">
<div class="modal-header">
<div style="display: flex; align-items: center; gap: 10px;">
<div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(106, 142, 174, 0.14); color: var(--color-blue); display: flex; align-items: center; justify-content: center;">
<i data-lucide="send" aria-hidden="true" style="width: 18px; height: 18px;"></i>
</div>
<div>
<h3 style="font-size: 1.25rem;">Publish Campus Announcement</h3>
<span style="font-size: var(--text-xs); color: var(--color-ink-subtle);">Broadcast to School-Wide Feed</span>
</div>
</div>
<button class="modal-close-btn" onclick="closeNewNoticeModal()" aria-label="Close dialog">
<i data-lucide="x" aria-hidden="true" style="width: 18px; height: 18px;"></i>
</button>
</div>
<div class="form-group">
<label class="form-label" for="notice-category">Channel / Category</label>
<select id="notice-category" style="width: 100%; padding: 12px 14px; border-radius: var(--radius-md); background: rgba(248, 244, 237, 0.6); border: 1px solid var(--color-border-warm);">
<option value="Operations">Operations</option>
<option value="Academics">Academics</option>
<option value="Student Life">Student Life</option>
<option value="IT">IT Systems</option>
</select>
</div>
<div class="form-group">
<label class="form-label" for="notice-headline">Announcement Headline</label>
<input id="notice-headline" placeholder="e.g. CBSE Term I Moderation Schedule Confirmed" style="width: 100%; padding: 12px 14px; border-radius: var(--radius-md);" type="text"/>
</div>
<div class="form-group" style="margin-bottom: 24px;">
<label class="form-label" for="notice-body">Message Content</label>
<textarea id="notice-body" placeholder="Enter detailed notice information for staff and students…" rows="3" style="width: 100%; padding: 12px 14px; border-radius: var(--radius-md); resize: vertical;"></textarea>
</div>
<div style="display: flex; gap: 12px; justify-content: flex-end;">
<button class="btn-secondary" onclick="closeNewNoticeModal()">Cancel</button>
<button class="btn-primary" onclick="submitNewNotice()" style="width: auto;">
<i data-lucide="send" aria-hidden="true" style="width: 16px; height: 16px;"></i>
<span>Publish to Feed</span>
</button>
</div>
</div>
</div>
  
  <!-- =========================================================================
       STATUTORY COMPLIANCE MODAL: PRIVACY POLICY & TERMS (Checklist A14)
       PRODUCTION NOTE: In a production deployment, comprehensive legal documents,
       terms of service, and privacy policies are rendered via canonical server routes
       (/privacy and /terms) reviewed by institutional legal counsel.
       ========================================================================= -->
  <div class="modal-overlay" id="compliance-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="compliance-modal-title" onclick="handleComplianceModalClick(event)">
    <div class="modal-window" style="max-width: 680px; max-height: 85vh; display: flex; flex-direction: column;">
      <div class="modal-header">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(106, 142, 174, 0.15); color: var(--color-blue); display: flex; align-items: center; justify-content: center;">
            <i data-lucide="shield-check" style="width: 20px; height: 20px;" aria-hidden="true"></i>
          </div>
          <div>
            <h3 id="compliance-modal-title" style="font-size: 1.25rem; font-family: var(--font-heading); font-weight: 600;">Institutional Governance &amp; Privacy</h3>
            <span id="compliance-modal-subtitle" style="font-size: var(--text-xs); color: var(--color-ink-subtle);">CBSE Senior Secondary Affiliation Standards</span>
          </div>
        </div>
        <button class="modal-close-btn" onclick="closeComplianceModal()" aria-label="Close Compliance Modal">
          <i data-lucide="x" style="width: 18px; height: 18px;" aria-hidden="true"></i>
        </button>
      </div>
      <div id="compliance-modal-body" style="padding: 14px 24px 20px; overflow-y: auto; font-size: var(--text-sm); line-height: 1.65; color: var(--color-ink-muted);">
        <!-- Populated dynamically: privacy or terms -->
      </div>
      <div style="padding: 16px 24px; border-top: 1px solid var(--color-border-subtle); display: flex; justify-content: flex-end; background: var(--color-surface-cream);">
        <button class="btn-primary" onclick="closeComplianceModal()" style="width: auto; padding: 8px 20px;">
          <span>Understood</span>
        </button>
      </div>
    </div>
  </div>

  <!-- =========================================================================
       FICTIONAL CAMPUS IT HELPDESK & SUPPORT MODAL (Checklist A17)
       ========================================================================= -->
  <div class="modal-overlay" id="support-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="support-modal-title" onclick="handleSupportModalClick(event)">
    <div class="modal-window" style="max-width: 560px;">
      <div class="modal-header">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(158, 187, 175, 0.25); color: #235240; display: flex; align-items: center; justify-content: center;">
            <i data-lucide="headphones" style="width: 20px; height: 20px;" aria-hidden="true"></i>
          </div>
          <div>
            <h3 id="support-modal-title" style="font-size: 1.25rem; font-family: var(--font-heading); font-weight: 600;">Academic IT Helpdesk</h3>
            <span style="font-size: var(--text-xs); color: var(--color-ink-subtle);">Central Computing &amp; Portal Dispatch</span>
          </div>
        </div>
        <button class="modal-close-btn" onclick="closeSupportModal()" aria-label="Close Support Modal">
          <i data-lucide="x" style="width: 18px; height: 18px;" aria-hidden="true"></i>
        </button>
      </div>
      <div style="padding: 16px 24px; font-size: var(--text-sm); line-height: 1.6; color: var(--color-ink-muted);">
        <div class="card card-flat" style="padding: 14px 16px; margin-bottom: 16px; background: rgba(106, 142, 174, 0.08); border-color: var(--color-border);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <strong style="color: var(--color-ink); font-size: var(--text-sm);">CBSE Academic Node 04</strong>
            <span class="badge badge-sage" style="padding: 2px 7px; font-size: 11px;">Operational · 99.98%</span>
          </div>
          <p style="font-size: var(--text-xs); color: var(--color-ink-subtle); margin: 0;">
            All 12 cluster compute instances reporting normal latency (18ms).
          </p>
        </div>

        <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px;">
          <div style="display: flex; align-items: center; gap: 12px;">
            <i data-lucide="map-pin" style="width: 16px; height: 16px; color: var(--color-blue); flex-shrink: 0;" aria-hidden="true"></i>
            <span><strong>Location:</strong> Academic Block A, Room 104 (Ground Floor)</span>
          </div>
          <div style="display: flex; align-items: center; gap: 12px;">
            <i data-lucide="phone" style="width: 16px; height: 16px; color: var(--color-blue); flex-shrink: 0;" aria-hidden="true"></i>
            <span><strong>Campus Intercom:</strong> Ext. 4402 (Mon–Sat, 08:00 – 17:00 IST)</span>
          </div>
          <div style="display: flex; align-items: center; gap: 12px;">
            <i data-lucide="mail" style="width: 16px; height: 16px; color: var(--color-blue); flex-shrink: 0;" aria-hidden="true"></i>
            <span><strong>Email Dispatch:</strong> <code style="font-size: 12px; background: var(--color-surface-cream); padding: 2px 6px; border-radius: 4px;">helpdesk@brainz.edu</code></span>
          </div>
        </div>

        <div style="border-top: 1px solid var(--color-border-subtle); padding-top: 16px;">
          <label class="form-label" for="support-quick-note" style="font-size: var(--text-xs); font-weight: 600;">Log Instant IT Incident Ticket</label>
          <input class="composer-input" id="support-quick-note" placeholder="e.g., RFID Gate Reader 2 sync lag in Commerce Lab" style="width: 100%; margin-top: 6px;"/>
        </div>
      </div>
      <div style="padding: 14px 24px; border-top: 1px solid var(--color-border-subtle); display: flex; justify-content: space-between; align-items: center; background: var(--color-surface-cream);">
        <button class="btn-secondary" onclick="closeSupportModal()" style="width: auto; padding: 8px 16px;">Cancel</button>
        <button class="btn-primary" onclick="submitSupportTicket()" style="width: auto; padding: 8px 20px;">
          <i data-lucide="send" style="width: 15px; height: 15px;" aria-hidden="true"></i>
          <span>Dispatch Ticket</span>
        </button>
      </div>
    </div>
  </div>

  <!-- =========================================================================
       COOKIE & LOCAL STORAGE COMPLIANCE BANNER (Checklist A15)
       PRODUCTION NOTE: Cookies and ad trackers are N/A for this client-side demo.
       In production, enterprise CMP software (OneTrust, Cookiebot) manages GDPR/DPDP consent.
       ========================================================================= -->
  <div class="cookie-banner" id="cookie-banner" role="complementary" aria-label="Session and Cookie Notice">
    <div class="cookie-content">
      <i data-lucide="shield" style="width: 18px; height: 18px; color: var(--color-blue); flex-shrink: 0;" aria-hidden="true"></i>
      <div>
        <strong>Institutional Session Notice:</strong> BrainzOS uses essential local browser storage to maintain session role authentication and simulation state. No commercial advertising trackers are executed.
      </div>
    </div>
    <div class="cookie-actions">
      <button type="button" class="btn-sm-primary" onclick="dismissCookieBanner()" aria-label="Acknowledge cookie policy">Acknowledge</button>
    </div>
  </div>

  <div id="app-toast" class="toast-notification system-toast" role="alert" aria-live="assertive">
    <div id="toast-icon-wrap" style="width: 28px; height: 28px; border-radius: 8px; background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center;">
      <i data-lucide="check" id="toast-icon" style="width: 16px; height: 16px;" aria-hidden="true"></i>
    </div>
    <div>
      <strong id="toast-title" style="display: block; font-size: var(--text-sm); line-height: 1.2;">Notification</strong>
      <span id="toast-message" style="font-size: var(--text-xs); color: rgba(255,255,255,0.75);">Action completed successfully.</span>
    </div>
  </div>



  <!-- =======================================================================
       4. CLIENT-SIDE RUNTIME LOGIC
       ======================================================================= -->
  <script>


    /* =========================================================================
       CORE BRAINZOS APPLICATION STATE & CONFIGURATION
       ========================================================================= */
    const STATE = {
      currentUser: null,
      currentPage: 'os-shell-welcome',
      cmdSelectedIndex: 0,
      isSidebarOpenMobile: false,
      activeReviewVentureId: null,
      emergencyActive: false
    };

    const DEMO_PROFILES = {
      student: {
        name: 'Ishaan Kalra',
        email: 'student@brainz.edu',
        role: 'student',
        roleLabel: 'Student',
        initials: 'IK',
        grade: 'Class XI-B · Stream Commerce',
        classInfo: 'Class XI-B',
        stream: 'Commerce',
        house: 'Orion',
        studentId: 'BOS-XIB-041'
      },
      teacher: {
        name: 'Aarav Mehta',
        email: 'teacher@brainz.edu',
        role: 'teacher',
        roleLabel: 'Teacher',
        initials: 'AM',
        grade: 'Senior Faculty · Dept. of Commerce & Humanities'
      },
      director: {
        name: 'Dr. Rhea Sharma',
        email: 'director@brainz.edu',
        role: 'director',
        roleLabel: 'Director',
        initials: 'RS',
        grade: 'Executive Leadership'
      }
    };

    const ROLE_NAV_CONFIG = {
      student: [
        { id: 'student-dashboard', label: 'Dashboard', icon: 'layout-dashboard', pageId: 'page-student-dashboard' },
        { id: 'student-timetable', label: 'Timetable', icon: 'calendar', pageId: 'page-student-timetable' },
        { id: 'student-assignments', label: 'Assignments', icon: 'check-square', pageId: 'page-student-assignments' },
        { id: 'student-pass', label: 'Digital Pass', icon: 'credit-card', pageId: 'page-student-pass' },
        { id: 'student-pitch', label: 'Pitch Pad', icon: 'rocket', pageId: 'page-student-pitch' },
        { id: 'student-clubs', label: 'Clubs & Houses', icon: 'shield', pageId: 'page-student-clubs' }
      ],
      teacher: [
        { id: 'teacher-overview', label: 'Overview', icon: 'layout-dashboard', pageId: 'page-teacher-overview' },
        { id: 'teacher-attendance', label: 'Period Attendance', icon: 'check-square', pageId: 'page-teacher-attendance' },
        { id: 'teacher-gradebook', label: 'Gradebook', icon: 'clipboard-check', pageId: 'page-teacher-gradebook' },
        { id: 'teacher-assignments', label: 'Class Assignments', icon: 'file-text', pageId: 'page-teacher-assignments' },
        { id: 'teacher-broadcasts', label: 'Broadcasts', icon: 'megaphone', pageId: 'page-teacher-broadcasts' }
      ],
      director: [
        { id: 'director-analytics', label: 'Executive Analytics', icon: 'layout-dashboard', pageId: 'page-director-analytics' },
        { id: 'director-emergency', label: 'Emergency Siren Trigger', icon: 'alert-octagon', pageId: 'page-director-emergency' },
        { id: 'director-feed', label: 'School-Wide Feed', icon: 'rss', pageId: 'page-director-feed' },
        { id: 'director-ventures', label: 'Venture Approvals', icon: 'rocket', pageId: 'page-director-ventures' },
        { id: 'director-audit', label: 'Audit Logs', icon: 'shield-check', pageId: 'page-director-audit' }
      ]
    };

    /* =========================================================================
       UNIFIED TOAST NOTIFICATION ENGINE
       ========================================================================= */
    let toastTimeout = null;
    function showToast(titleOrMsg, desc, iconName = 'check') {
      const toast = document.getElementById('app-toast');
      if (!toast) return;

      const titleEl = document.getElementById('toast-title');
      const msgEl = document.getElementById('toast-message');
      const iconEl = document.getElementById('toast-icon');

      if (desc !== undefined) {
        if (titleEl) titleEl.textContent = titleOrMsg;
        if (msgEl) msgEl.textContent = desc;
      } else {
        if (titleEl) titleEl.textContent = 'System Update';
        if (msgEl) msgEl.textContent = titleOrMsg;
      }

      if (iconEl && iconName) {
        iconEl.setAttribute('data-lucide', iconName);
      }

      toast.classList.add('active');
      if (window.lucide) lucide.createIcons();

      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.remove('active');
      }, 3200);
    }

    /* =========================================================================
       AUTHENTICATION & ROLE DETECTION ENGINE
       ========================================================================= */
    function detectRoleFromEmail(emailStr) {
      const normalized = (emailStr || '').trim().toLowerCase();
      if (!normalized) return null;

      if (normalized.includes('director') || normalized.includes('admin') || normalized.includes('head')) {
        return 'director';
      }
      if (normalized.includes('teacher') || normalized.includes('faculty') || normalized.includes('prof')) {
        return 'teacher';
      }
      if (normalized.includes('student') || normalized.includes('pupil') || normalized.includes('scholar')) {
        return 'student';
      }
      if (normalized.endsWith('@brainz.edu')) {
        return 'student';
      }
      return null;
    }

    function updateRoleIndicatorUI(role) {
      const detectorBox = document.getElementById('role-detector-box');
      const detectorText = document.getElementById('role-detector-text');
      const continueBtn = document.getElementById('continue-btn');
      if (!detectorBox || !detectorText || !continueBtn) return;

      detectorText.className = 'detection-result';

      if (role === 'student') {
        detectorBox.className = 'role-detection-box detected-student';
        detectorText.innerHTML = `
          <span class="role-dot" style="background: var(--color-blue)"></span>
          <span>Role: <strong>Student</strong> (Ishaan Kalra · Class XI-B)</span>
        `;
        continueBtn.removeAttribute('disabled');
      } else if (role === 'teacher') {
        detectorBox.className = 'role-detection-box detected-teacher';
        detectorText.innerHTML = `
          <span class="role-dot" style="background: var(--color-sage)"></span>
          <span>Role: <strong>Faculty / Teacher</strong> (Aarav Mehta · Senior Faculty)</span>
        `;
        continueBtn.removeAttribute('disabled');
      } else if (role === 'director') {
        detectorBox.className = 'role-detection-box detected-director';
        detectorText.innerHTML = `
          <span class="role-dot" style="background: #A08264"></span>
          <span>Role: <strong>Directorate / Admin</strong> (Dr. Rhea Sharma · Executive)</span>
        `;
        continueBtn.removeAttribute('disabled');
      } else {
        detectorBox.className = 'role-detection-box';
        detectorText.innerHTML = `
          <span class="role-dot"></span>
          <span>Awaiting valid school email…</span>
        `;
        continueBtn.setAttribute('disabled', 'true');
      }
    }

    /* Safe Input Sanitization (Checklist B9: Prevent DOM XSS Injection) */
    function escapeHtml(str) {
      if (typeof str !== 'string') return '';
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function clearLoginError() {
      const emailInput = document.getElementById('school-email');
      const errorEl = document.getElementById('login-email-error');
      if (emailInput) {
        emailInput.classList.remove('has-error');
        emailInput.removeAttribute('aria-invalid');
      }
      if (errorEl) {
        errorEl.style.display = 'none';
      }
    }

    function showLoginError(msg) {
      const emailInput = document.getElementById('school-email');
      const errorEl = document.getElementById('login-email-error');
      const errorText = document.getElementById('login-email-error-text');
      if (emailInput) {
        emailInput.classList.add('has-error');
        emailInput.setAttribute('aria-invalid', 'true');
        emailInput.focus();
      }
      if (errorText) errorText.textContent = msg;
      if (errorEl) errorEl.style.display = 'flex';
      if (window.lucide) lucide.createIcons();
    }

    function quickSelectRole(role) {
      clearLoginError();
      const emailInput = document.getElementById('school-email');
      if (!emailInput) return;
      if (role === 'student') emailInput.value = 'student@brainz.edu';
      else if (role === 'teacher') emailInput.value = 'teacher@brainz.edu';
      else if (role === 'director') emailInput.value = 'director@brainz.edu';
      updateRoleIndicatorUI(role);
      emailInput.focus();
    }

    function handleLoginSubmit(event) {
      if (event) event.preventDefault();
      clearLoginError();
      const emailInput = document.getElementById('school-email');
      const emailVal = emailInput ? emailInput.value.trim() : '';

      if (!emailVal) {
        showLoginError('Please enter your school email address to proceed.');
        return;
      }

      // Basic regex check for institutional email format
      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailPattern.test(emailVal)) {
        showLoginError('Please enter a syntactically valid institutional email address.');
        return;
      }

      const detectedRole = detectRoleFromEmail(emailVal);
      if (!detectedRole) {
        showLoginError('Unrecognized domain. Please enter an authorized @brainz.edu address or choose a demo role above.');
        showToast('Access Verification Failed', 'Email domain not authorized on CBSE Academic Cluster.', 'alert-circle');
        return;
      }

      const userProfile = DEMO_PROFILES[detectedRole] || {
        name: escapeHtml(emailVal.split('@')[0].toUpperCase()),
        email: escapeHtml(emailVal),
        role: detectedRole,
        roleLabel: detectedRole.charAt(0).toUpperCase() + detectedRole.slice(1),
        initials: escapeHtml(emailVal.substring(0, 2).toUpperCase())
      };

      executeLogin(userProfile);
    }

    function executeLogin(userObj) {
      STATE.currentUser = userObj;

      // Update Topbar and Sidebar user details
      const userNameEls = ['sidebar-user-name', 'topbar-user-name'];
      userNameEls.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = userObj.name;
      });

      const userAvatarEls = ['sidebar-user-avatar', 'topbar-user-avatar'];
      userAvatarEls.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = userObj.initials;
      });

      const sidebarBadge = document.getElementById('sidebar-user-badge');
      if (sidebarBadge) sidebarBadge.textContent = userObj.roleLabel;

      const topbarRole = document.getElementById('topbar-user-role');
      if (topbarRole) {
        if (userObj.role === 'student') topbarRole.textContent = 'Class XI-B · Commerce';
        else if (userObj.role === 'teacher') topbarRole.textContent = 'Faculty · Humanities';
        else topbarRole.textContent = 'Executive Leadership';
      }

      // Hide login, show app viewport
      const loginViewport = document.getElementById('login-viewport');
      const appViewport = document.getElementById('app-viewport');
      if (loginViewport) loginViewport.classList.add('hidden-view');
      if (appViewport) appViewport.classList.add('active-view');

      // Render role navigation
      renderSidebarNav();

      // Initialize role-specific views
      if (userObj.role === 'student') {
        initStudentModules();
        navigateTo('page-student-dashboard');
      } else if (userObj.role === 'teacher') {
        renderAttendanceTable();
        renderGradebookTable();
        renderAssignmentsList();
        renderBroadcastsList();
        navigateTo('page-teacher-overview');
      } else if (userObj.role === 'director') {
        renderVenturesTable();
        renderFeed();
        renderAuditLogsTable();
        refreshAnalyticsMetrics();
        animateDepartmentBars();
        navigateTo('page-director-analytics');
      }

      showToast('Authenticated', `Welcome back, ${userObj.name} (${userObj.roleLabel})`, 'shield-check');

      if (window.lucide) {
        lucide.createIcons();
      }
    }

    function startBiometricLogin() {
      const bioOverlay = document.getElementById('biometric-overlay');
      const bioLaser = document.getElementById('bio-laser');
      const iconScan = document.getElementById('bio-icon-scan');
      const iconCheck = document.getElementById('bio-icon-check');
      const statusTitle = document.getElementById('bio-status-title');
      const statusDesc = document.getElementById('bio-status-desc');

      const emailInput = document.getElementById('school-email');
      const emailVal = emailInput ? emailInput.value.trim() : '';
      const detectedRole = detectRoleFromEmail(emailVal) || 'student';
      const targetUser = DEMO_PROFILES[detectedRole] || DEMO_PROFILES.student;

      bioLaser.style.display = 'block';
      iconScan.style.display = 'block';
      iconCheck.style.display = 'none';
      statusTitle.textContent = 'Institutional Biometrics';
      statusDesc.textContent = 'Scanning registered hardware key & credentials…';
      bioOverlay.classList.add('active');

      if (window.lucide) lucide.createIcons();

      setTimeout(() => {
        bioLaser.style.display = 'none';
        iconScan.style.display = 'none';
        iconCheck.style.display = 'block';
        statusTitle.textContent = 'Identity Verified';
        statusDesc.textContent = `Logging in as ${targetUser.roleLabel} (${targetUser.name})…`;
        if (window.lucide) lucide.createIcons();

        setTimeout(() => {
          bioOverlay.classList.remove('active');
          executeLogin(targetUser);
        }, 600);
      }, 1100);
    }

    function logoutUser() {
      STATE.currentUser = null;

      const emailInput = document.getElementById('school-email');
      if (emailInput) {
        emailInput.value = '';
      }
      clearLoginError();
      updateRoleIndicatorUI(null);

      // Clear any route hash
      if (window.location.hash) {
        history.replaceState(null, null, ' ');
      }

      const loginViewport = document.getElementById('login-viewport');
      const appViewport = document.getElementById('app-viewport');
      if (appViewport) appViewport.classList.remove('active-view');
      if (loginViewport) loginViewport.classList.remove('hidden-view');

      const allPages = document.querySelectorAll('.os-page');
      allPages.forEach(p => p.classList.remove('active'));
      const welcomePage = document.getElementById('os-shell-welcome');
      if (welcomePage) welcomePage.classList.add('active');

      document.title = 'BrainzOS — Institutional Operating System | CBSE Senior Secondary Cluster';

      if (window.lucide) {
        lucide.createIcons();
      }
    }

    /* =========================================================================
       ROUTING, PERMISSIONS & APP SHELL CONTROLLER (Checklist A1, A3, A11, B5, B10)
       ========================================================================= */
    const ROLE_PERMISSIONS = {
      student: [
        'page-student-dashboard',
        'page-student-timetable',
        'page-student-assignments',
        'page-student-pass',
        'page-student-pitch',
        'page-student-clubs',
        'os-shell-welcome',
        'page-404'
      ],
      teacher: [
        'page-teacher-overview',
        'page-teacher-attendance',
        'page-teacher-gradebook',
        'page-teacher-assignments',
        'page-teacher-broadcasts',
        'os-shell-welcome',
        'page-404'
      ],
      director: [
        'page-director-analytics',
        'page-director-emergency',
        'page-director-feed',
        'page-director-ventures',
        'page-director-audit',
        'page-teacher-overview',
        'page-teacher-attendance',
        'page-teacher-gradebook',
        'page-teacher-assignments',
        'page-teacher-broadcasts',
        'page-student-dashboard',
        'page-student-timetable',
        'page-student-assignments',
        'page-student-pass',
        'page-student-pitch',
        'page-student-clubs',
        'os-shell-welcome',
        'page-404'
      ]
    };

    const PAGE_TITLES = {
      'page-student-dashboard': 'Student Dashboard',
      'page-student-timetable': 'Class Timetable',
      'page-student-assignments': 'Coursework & Assignments',
      'page-student-pass': 'Digital Student Pass',
      'page-student-pitch': 'Pitch Pad Incubator',
      'page-student-clubs': 'Student Clubs & Houses',
      'page-teacher-overview': 'Faculty Overview',
      'page-teacher-attendance': 'Period Attendance Roll',
      'page-teacher-gradebook': 'Continuous Gradebook',
      'page-teacher-assignments': 'Class Assignment Manager',
      'page-teacher-broadcasts': 'Broadcast Transmitter',
      'page-director-analytics': 'Executive Analytics',
      'page-director-emergency': 'Campus Emergency Command',
      'page-director-feed': 'School Noticeboard Feed',
      'page-director-ventures': 'Incubator Venture Approvals',
      'page-director-audit': 'Audit & Compliance Ledger',
      'os-shell-welcome': 'System Overview',
      'page-404': 'Page Not Found'
    };

    const DATA_HEAVY_PAGES = {
      'page-teacher-attendance': 'Syncing biometric attendance ledger…',
      'page-teacher-gradebook': 'Recalculating term continuous assessment marks…',
      'page-director-audit': 'Verifying cryptographic audit hashes…',
      'page-director-analytics': 'Aggregating campus performance telemetry…',
      'page-director-ventures': 'Loading student venture review queue…',
      'page-student-assignments': 'Loading active coursework syllabus…',
      'page-teacher-broadcasts': 'Connecting to broadcast feed gateway…'
    };

    function navigateTo(pageId, skipLoader = false) {
      // 1. BLOCK UNAUTHENTICATED ROUTES (Checklist B10)
      if (!STATE.currentUser) {
        const loginViewport = document.getElementById('login-viewport');
        const appViewport = document.getElementById('app-viewport');
        if (appViewport) appViewport.classList.remove('active-view');
        if (loginViewport) loginViewport.classList.remove('hidden-view');
        if (window.location.hash) {
          history.replaceState(null, null, ' ');
        }
        showToast('Authentication Required', 'Please sign in to access BrainzOS modules.', 'shield-alert');
        return;
      }

      // 2. UNKNOWN ROUTE / CUSTOM 404 HANDLING (Checklist A1)
      const targetEl = document.getElementById(pageId);
      if (!targetEl || !targetEl.classList.contains('os-page')) {
        render404View(pageId);
        return;
      }

      // 3. ADMIN & ROLE-BASED ROUTE LOCKING (Checklist B5)
      const userRole = STATE.currentUser.role;
      const allowedPages = ROLE_PERMISSIONS[userRole] || [];
      if (!allowedPages.includes(pageId)) {
        // Access Denied: Prevent students from entering Director or Teacher pages
        showToast('Access Denied', `Role clearance insufficient for ${PAGE_TITLES[pageId] || pageId}.`, 'shield-alert');
        const fallbackDashboard = userRole === 'director' ? 'page-director-analytics' : (userRole === 'teacher' ? 'page-teacher-overview' : 'page-student-dashboard');
        navigateTo(fallbackDashboard, true);
        return;
      }

      // 4. ASYNC SKELETON / LOADER SIMULATION (Checklist A11)
      const loader = document.getElementById('async-route-loader');
      const loaderStatus = document.getElementById('loader-status-text');
      const isHeavy = DATA_HEAVY_PAGES[pageId];

      if (!skipLoader && isHeavy && loader) {
        if (loaderStatus) loaderStatus.textContent = isHeavy;
        loader.classList.add('active');

        setTimeout(() => {
          loader.classList.remove('active');
          executePageTransition(pageId, targetEl);
        }, 220);
        return;
      }

      executePageTransition(pageId, targetEl);
    }

    function executePageTransition(pageId, targetEl) {
      const allPages = document.querySelectorAll('.os-page');
      allPages.forEach(p => p.classList.remove('active'));

      targetEl.classList.add('active');
      STATE.currentPage = pageId;

      const navButtons = document.querySelectorAll('.nav-btn');
      navButtons.forEach(btn => {
        if (btn.getAttribute('data-page-id') === pageId) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      // Update Document Title (Checklist A3)
      const pageTitle = PAGE_TITLES[pageId] || 'Institutional Workspace';
      document.title = `${pageTitle} · BrainzOS Institutional OS`;

      // Synchronize URL Hash without page reload or infinite loops
      const cleanSlug = pageId.replace(/^page-/, '');
      if (window.location.hash !== `#${cleanSlug}`) {
        history.replaceState(null, null, `#${cleanSlug}`);
      }

      if (STATE.isSidebarOpenMobile) {
        toggleMobileSidebar(false);
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });

      if (pageId === 'page-student-pass') {
        renderDigitalPassQR();
      } else if (pageId === 'page-director-analytics') {
        animateDepartmentBars();
      }

      if (window.lucide) {
        lucide.createIcons();
      }
    }

    function render404View(unresolvedRoute) {
      const allPages = document.querySelectorAll('.os-page');
      allPages.forEach(p => p.classList.remove('active'));

      const notFoundPage = document.getElementById('page-404');
      if (notFoundPage) {
        notFoundPage.classList.add('active');
        STATE.currentPage = 'page-404';
        const slugEl = document.getElementById('notfound-route-slug');
        if (slugEl) {
          slugEl.textContent = `/${escapeHtml(unresolvedRoute || 'unknown')}`;
        }
        document.title = `Route Not Found · BrainzOS`;
      }

      if (window.lucide) lucide.createIcons();
    }

    function returnToRoleDashboard() {
      if (!STATE.currentUser) {
        logoutUser();
        return;
      }
      const role = STATE.currentUser.role;
      if (role === 'student') navigateTo('page-student-dashboard');
      else if (role === 'teacher') navigateTo('page-teacher-overview');
      else if (role === 'director') navigateTo('page-director-analytics');
      else navigateTo('os-shell-welcome');
    }

    // URL Hash Navigation Observer (Checklist A1 & B5)
    window.addEventListener('hashchange', () => {
      if (!STATE.currentUser) {
        if (window.location.hash) history.replaceState(null, null, ' ');
        return;
      }
      const rawHash = window.location.hash.replace(/^#\/?/, '').trim();
      if (!rawHash) return;
      const resolvedPageId = rawHash.startsWith('page-') ? rawHash : (rawHash === 'os-shell-welcome' ? rawHash : `page-${rawHash}`);
      navigateTo(resolvedPageId);
    });

    /* Statutory Compliance Modal Engine (Checklist A14) */
    function openComplianceModal(type) {
      const overlay = document.getElementById('compliance-modal-overlay');
      const title = document.getElementById('compliance-modal-title');
      const subtitle = document.getElementById('compliance-modal-subtitle');
      const body = document.getElementById('compliance-modal-body');
      if (!overlay || !title || !body) return;

      if (type === 'terms') {
        title.textContent = 'Terms of Institutional Workspace';
        if (subtitle) subtitle.textContent = 'CBSE Affiliation Rulebook & Academic Acceptable Use';
        body.innerHTML = `
          <h4 style="color: var(--color-ink); margin-bottom: 8px;">1. Authorized Educational Purpose</h4>
          <p style="margin-bottom: 14px;">BrainzOS is provisioned solely for registered students, faculty, and administrative leadership of Brainz International School. Unauthorized access, automated scraping, or credential sharing is strictly prohibited under institutional bylaws.</p>
          <h4 style="color: var(--color-ink); margin-bottom: 8px;">2. Academic Honor &amp; Integrity</h4>
          <p style="margin-bottom: 14px;">Coursework submissions, digital passes, and venture incubation materials represent authentic student intellectual property. All evaluation adjustments are logged in tamper-evident audit ledgers.</p>
          <h4 style="color: var(--color-ink); margin-bottom: 8px;">3. Directorial Override</h4>
          <p>The Directorate reserves unilateral authority to initiate campus safety overrides, pause continuous evaluations, and conduct security reviews as mandated by statutory educational authorities.</p>
        `;
      } else {
        title.textContent = 'Data Custody & Privacy Policy';
        if (subtitle) subtitle.textContent = 'CBSE Rule 24.1 & Digital Personal Data Protection (DPDP) Standard';
        body.innerHTML = `
          <h4 style="color: var(--color-ink); margin-bottom: 8px;">1. Student &amp; Faculty Data Isolation</h4>
          <p style="margin-bottom: 14px;">All academic records, marks sheets, and attendance registers are governed under strict multi-role isolation policies. Student identities cannot access administrative or directorial evaluation records.</p>
          <h4 style="color: var(--color-ink); margin-bottom: 8px;">2. Biometric Token Storage</h4>
          <p style="margin-bottom: 14px;">Digital pass barcodes and biometric hardware scans utilize salted one-way hashes stored locally within the browser session context. Raw biometric scans are never stored or transmitted across external networks.</p>
          <h4 style="color: var(--color-ink); margin-bottom: 8px;">3. Audit Ledger Retention</h4>
          <p>Administrative actions (venture approvals, notice broadcasts, emergency triggers) are indelibly recorded in session-bound audit ledgers for compliance reporting and grievance redressal.</p>
        `;
      }

      overlay.classList.add('active');
      if (window.lucide) lucide.createIcons();
    }

    function closeComplianceModal() {
      const overlay = document.getElementById('compliance-modal-overlay');
      if (overlay) overlay.classList.remove('active');
    }

    function handleComplianceModalClick(e) {
      if (e.target.id === 'compliance-modal-overlay') closeComplianceModal();
    }

    /* Campus IT Helpdesk Modal Engine (Checklist A17) */
    function openSupportModal() {
      const overlay = document.getElementById('support-modal-overlay');
      if (overlay) overlay.classList.add('active');
      if (window.lucide) lucide.createIcons();
    }

    function closeSupportModal() {
      const overlay = document.getElementById('support-modal-overlay');
      if (overlay) overlay.classList.remove('active');
    }

    function handleSupportModalClick(e) {
      if (e.target.id === 'support-modal-overlay') closeSupportModal();
    }

    function submitSupportTicket() {
      const input = document.getElementById('support-quick-note');
      const val = input ? input.value.trim() : '';
      if (!val) {
        showToast('Input Required', 'Please enter a brief description of the IT issue.', 'alert-circle');
        return;
      }
      closeSupportModal();
      if (input) input.value = '';
      showToast('Dispatch Confirmed', `Ticket #BOS-${Math.floor(1000 + Math.random() * 9000)} logged with Central IT.`, 'check-circle');
    }

    /* Cookie Banner Engine (Checklist A15) */
    function dismissCookieBanner() {
      const banner = document.getElementById('cookie-banner');
      if (banner) banner.classList.add('dismissed');
      try {
        localStorage.setItem('brainzos_cookie_dismissed', 'true');
      } catch (e) {}
    }

    function initCookieBanner() {
      try {
        if (localStorage.getItem('brainzos_cookie_dismissed') === 'true') {
          const banner = document.getElementById('cookie-banner');
          if (banner) banner.classList.add('dismissed');
        }
      } catch (e) {}
    }

    function renderSidebarNav() {
      const navContainer = document.getElementById('sidebar-nav-container');
      if (!navContainer) return;
      navContainer.innerHTML = '';

      if (!STATE.currentUser) return;

      const role = STATE.currentUser.role;
      const navList = ROLE_NAV_CONFIG[role] || [];

      const catHeading = document.createElement('div');
      catHeading.className = 'nav-category';
      if (role === 'student') catHeading.textContent = 'Student Modules';
      else if (role === 'teacher') catHeading.textContent = 'Faculty Tools';
      else if (role === 'director') catHeading.textContent = 'Directorate Controls';
      else catHeading.textContent = `${STATE.currentUser.roleLabel} Modules`;
      navContainer.appendChild(catHeading);

      if (navList.length === 0) {
        const emptyNotice = document.createElement('div');
        emptyNotice.style.padding = '12px 14px';
        emptyNotice.style.fontSize = '12px';
        emptyNotice.style.color = 'var(--color-ink-subtle)';
        emptyNotice.style.fontStyle = 'italic';
        emptyNotice.textContent = 'No navigation items available.';
        navContainer.appendChild(emptyNotice);
      } else {
        navList.forEach(item => {
          const btn = document.createElement('button');
          btn.className = `nav-btn ${item.pageId === STATE.currentPage ? 'active' : ''}`;
          btn.setAttribute('data-page-id', item.pageId);
          btn.onclick = () => navigateTo(item.pageId);
          btn.innerHTML = `
            <i data-lucide="${item.icon}" aria-hidden="true"></i>
            <span>${item.label}</span>
          `;
          navContainer.appendChild(btn);
        });
      }

      const systemCategory = document.createElement('div');
      systemCategory.className = 'nav-category';
      systemCategory.style.marginTop = '18px';
      systemCategory.textContent = 'System';
      navContainer.appendChild(systemCategory);

      const overviewBtn = document.createElement('button');
      overviewBtn.className = `nav-btn ${STATE.currentPage === 'os-shell-welcome' ? 'active' : ''}`;
      overviewBtn.setAttribute('data-page-id', 'os-shell-welcome');
      overviewBtn.onclick = () => navigateTo('os-shell-welcome');
      overviewBtn.innerHTML = `
        <i data-lucide="info" aria-hidden="true"></i>
        <span>System Status</span>
      `;
      navContainer.appendChild(overviewBtn);

      if (window.lucide) {
        lucide.createIcons();
      }
    }

    function toggleMobileSidebar(forceState) {
      const sidebar = document.getElementById('app-sidebar');
      if (!sidebar) return;
      if (typeof forceState === 'boolean') {
        STATE.isSidebarOpenMobile = forceState;
      } else {
        STATE.isSidebarOpenMobile = !STATE.isSidebarOpenMobile;
      }

      if (STATE.isSidebarOpenMobile) {
        sidebar.classList.add('mobile-open');
      } else {
        sidebar.classList.remove('mobile-open');
      }
    }

    /* =========================================================================
       COMMAND PALETTE ENGINE (⌘K / Ctrl+K)
       ========================================================================= */
    const cmdOverlay = document.getElementById('cmd-overlay');
    const cmdInput = document.getElementById('cmd-input');
    const cmdResultsList = document.getElementById('cmd-results-list');

    function openCommandLauncher() {
      if (!STATE.currentUser) return;
      if (!cmdOverlay) return;
      cmdOverlay.classList.add('active');
      if (cmdInput) cmdInput.value = '';
      STATE.cmdSelectedIndex = 0;
      filterCommandResults('');
      setTimeout(() => { if (cmdInput) cmdInput.focus(); }, 50);
    }

    function closeCommandLauncher() {
      if (!cmdOverlay) return;
      cmdOverlay.classList.remove('active');
      if (cmdInput) cmdInput.blur();
    }

    function handleCmdOverlayClick(e) {
      if (e.target === cmdOverlay) {
        closeCommandLauncher();
      }
    }

    function highlightCmdItem(items) {
      const renderedItems = cmdResultsList.querySelectorAll('.cmd-item');
      renderedItems.forEach((it, idx) => {
        if (idx === STATE.cmdSelectedIndex) {
          it.classList.add('selected');
          it.scrollIntoView({ block: 'nearest' });
        } else {
          it.classList.remove('selected');
        }
      });
    }

    function filterCommandResults(query) {
      if (!cmdResultsList) return;
      cmdResultsList.innerHTML = '';
      const q = query.trim().toLowerCase();

      if (!STATE.currentUser) return;

      const role = STATE.currentUser.role;
      const roleNavs = ROLE_NAV_CONFIG[role] || [];

      const navActions = roleNavs.map(item => ({
        label: item.label,
        group: `${STATE.currentUser.roleLabel} Navigation`,
        icon: item.icon || 'arrow-right',
        action: () => navigateTo(item.pageId)
      }));

      const roleActions = [];
      if (role === 'student') {
        roleActions.push(
          {
            label: 'View Digital Pass',
            group: 'Quick Student Actions',
            icon: 'credit-card',
            action: () => navigateTo('page-student-pass')
          },
          {
            label: 'Vote on Pitch Pad Incubator',
            group: 'Quick Student Actions',
            icon: 'rocket',
            action: () => navigateTo('page-student-pitch')
          },
          {
            label: 'Check Today’s Timetable',
            group: 'Quick Student Actions',
            icon: 'calendar',
            action: () => navigateTo('page-student-timetable')
          }
        );
      } else if (role === 'teacher') {
        roleActions.push(
          {
            label: 'Create New Assignment',
            group: 'Quick Faculty Actions',
            icon: 'plus',
            action: () => {
              navigateTo('page-teacher-assignments');
              openNewAssignmentModal();
            }
          },
          {
            label: 'Mark All Students Present',
            group: 'Quick Faculty Actions',
            icon: 'check-check',
            action: () => {
              navigateTo('page-teacher-attendance');
              markAllPresent();
            }
          },
          {
            label: 'Compose Institutional Broadcast',
            group: 'Quick Faculty Actions',
            icon: 'megaphone',
            action: () => navigateTo('page-teacher-broadcasts')
          }
        );
      } else if (role === 'director') {
        roleActions.push(
          {
            label: 'Trigger Campus Emergency Siren',
            group: 'Directorial Safety Controls',
            icon: 'alert-octagon',
            action: () => {
              navigateTo('page-director-emergency');
              openEmergencyModal();
            }
          },
          {
            label: 'Review Pending Student Ventures',
            group: 'Directorial Quick Actions',
            icon: 'rocket',
            action: () => navigateTo('page-director-ventures')
          },
          {
            label: 'Run Silent Handshake Diagnostic',
            group: 'Directorial Quick Actions',
            icon: 'activity',
            action: () => {
              navigateTo('page-director-emergency');
              runSilentDiagnosticTest();
            }
          },
          {
            label: 'Post New School Notice',
            group: 'Directorial Quick Actions',
            icon: 'send',
            action: () => {
              navigateTo('page-director-feed');
              openNewNoticeModal();
            }
          }
        );
      }

      const systemActions = [
        {
          label: 'System Status & Shell Overview',
          group: 'Core System',
          icon: 'info',
          action: () => navigateTo('os-shell-welcome')
        },
        {
          label: 'Sign Out / Lock Session',
          group: 'Session',
          icon: 'log-out',
          action: () => {
            closeCommandLauncher();
            logoutUser();
          }
        }
      ];

      const allActions = [...navActions, ...roleActions, ...systemActions];
      const filtered = allActions.filter(item => 
        item.label.toLowerCase().includes(q) || 
        item.group.toLowerCase().includes(q)
      );

      if (filtered.length === 0) {
        cmdResultsList.innerHTML = `
          <div class="cmd-empty">
            No matching destinations or commands found for "${query}".
          </div>
        `;
        return;
      }

      let currentGroup = '';
      filtered.forEach((item, index) => {
        if (item.group !== currentGroup) {
          currentGroup = item.group;
          const groupTitle = document.createElement('div');
          groupTitle.className = 'cmd-group-title';
          groupTitle.textContent = currentGroup;
          cmdResultsList.appendChild(groupTitle);
        }

        const row = document.createElement('div');
        row.className = `cmd-item ${index === STATE.cmdSelectedIndex ? 'selected' : ''}`;
        row.innerHTML = `
          <div class="cmd-item-left">
            <i data-lucide="${item.icon}" aria-hidden="true"></i>
            <span>${item.label}</span>
          </div>
          <span class="cmd-item-shortcut">↵</span>
        `;

        row.onmouseenter = () => {
          STATE.cmdSelectedIndex = index;
          highlightCmdItem(filtered);
        };

        row.onclick = () => {
          closeCommandLauncher();
          item.action();
        };

        cmdResultsList.appendChild(row);
      });

      if (window.lucide) lucide.createIcons();
    }


const TIMETABLE_DATA = [
      { id: 1, periodNum: 'Period 1', name: 'English Core', code: 'ENG-101', teacher: 'Ms. Ananya Sen', room: 'Room 204', startH: 8, startM: 30, endH: 9, endM: 20 },
      { id: 2, periodNum: 'Period 2', name: 'Economics', code: 'ECO-201', teacher: 'Mr. Rajiv Mehta', room: 'Room 208', startH: 9, startM: 25, endH: 10, endM: 15 },
      { id: 3, periodNum: 'Period 3', name: 'Accountancy', code: 'ACC-301', teacher: 'Mrs. Sunita Sharma', room: 'Room 112', startH: 10, startM: 20, endH: 11, endM: 10 },
      { id: 4, periodNum: 'Period 4', name: 'Political Science', code: 'POL-401', teacher: 'Dr. Kabir Roy', room: 'Room 301', startH: 11, startM: 15, endH: 12, endM: 5 },
      { id: 5, periodNum: 'Recess', name: 'Break', code: 'BRK-001', teacher: 'Campus Supervisors', room: 'Central Quad & Cafeteria', startH: 12, startM: 5, endH: 12, endM: 45, isBreak: true },
      { id: 6, periodNum: 'Period 5', name: 'Business Studies', code: 'BST-501', teacher: 'Mr. David Vance', room: 'Room 210', startH: 12, startM: 45, endH: 13, endM: 35 }
    ];

    let timetableDetectionMode = 'live'; // 'live' | 'sim'
    let simulatedSecondTicker = 24 * 60 + 18; // Simulated 24m 18s ticker for test demo mode

    function setTimetableMode(mode) {
      timetableDetectionMode = mode;
      const pillLive = document.getElementById('mode-pill-live');
      const pillSim = document.getElementById('mode-pill-sim');
      const hint = document.getElementById('timetable-mode-hint');

      if (mode === 'live') {
        pillLive.classList.add('active');
        pillSim.classList.remove('active');
        hint.textContent = 'Evaluating current system clock against period start & end intervals.';
      } else {
        pillLive.classList.remove('active');
        pillSim.classList.add('active');
        hint.textContent = 'Active simulation: Period 3 (Accountancy · 10:20 - 11:10 AM) active with live countdown.';
      }
      updateTimetableState();
    }

    function formatTime12(h, m) {
      const ampm = h >= 12 ? 'PM' : 'AM';
      const hr = h % 12 === 0 ? 12 : h % 12;
      const min = m < 10 ? '0' + m : m;
      return `${hr}:${min} ${ampm}`;
    }

    function updateTimetableState() {
      const now = new Date();
      const realClockEl = document.getElementById('timetable-real-clock');
      if (realClockEl) {
        realClockEl.textContent = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      }

      // Compute current time in minutes from midnight
      let currentMinutes;
      if (timetableDetectionMode === 'live') {
        currentMinutes = now.getHours() * 60 + now.getMinutes() + now.getSeconds() / 60;
      } else {
        // In sim mode: 10:45 AM + offset corresponding to ticking simulatedSecondTicker
        const elapsedSimMins = (50 * 60 - simulatedSecondTicker) / 60;
        currentMinutes = (10 * 60 + 20) + elapsedSimMins;
      }

      let activePeriod = null;
      let activeRemainingSecs = 0;
      let nextUpcomingPeriod = null;

      // Analyze each period
      const computedPeriods = TIMETABLE_DATA.map(p => {
        const startTotal = p.startH * 60 + p.startM;
        const endTotal = p.endH * 60 + p.endM;
        const durationSecs = (endTotal - startTotal) * 60;

        let status = 'UPCOMING';
        let remainingSecs = 0;

        if (currentMinutes >= endTotal) {
          status = 'COMPLETE';
        } else if (currentMinutes >= startTotal && currentMinutes < endTotal) {
          status = 'LIVE NOW';
          remainingSecs = Math.max(0, Math.floor((endTotal - currentMinutes) * 60));
          activePeriod = p;
          activeRemainingSecs = remainingSecs;
        } else {
          status = 'UPCOMING';
          if (!nextUpcomingPeriod) {
            nextUpcomingPeriod = p;
          }
        }

        return {
          ...p,
          status,
          remainingSecs,
          durationSecs,
          timeFormatted: `${formatTime12(p.startH, p.startM)} – ${formatTime12(p.endH, p.endM)}`
        };
      });

      // If no period is currently live in live clock mode (e.g. night time or before school),
      // we default hero display to either next upcoming or first period, with appropriate status
      const heroPeriod = activePeriod 
        ? computedPeriods.find(p => p.id === activePeriod.id)
        : (nextUpcomingPeriod ? computedPeriods.find(p => p.id === nextUpcomingPeriod.id) : computedPeriods[0]);

      // Update Hero Highlight Card
      const heroNameEl = document.getElementById('hero-period-name');
      const heroMetaEl = document.getElementById('hero-period-meta');
      const heroTimeEl = document.getElementById('hero-period-time');
      const heroBadgeText = document.getElementById('hero-period-status-text');
      const heroTimerEl = document.getElementById('hero-countdown-timer');
      const heroProgressEl = document.getElementById('hero-countdown-progress');

      if (heroPeriod && heroNameEl) {
        heroNameEl.textContent = heroPeriod.name;
        heroMetaEl.textContent = `${heroPeriod.room} · ${heroPeriod.teacher} · CBSE Secondary Curriculum`;
        heroTimeEl.textContent = heroPeriod.timeFormatted;

        if (heroPeriod.status === 'LIVE NOW') {
          heroBadgeText.textContent = 'LIVE NOW';
          const mins = Math.floor(heroPeriod.remainingSecs / 60);
          const secs = heroPeriod.remainingSecs % 60;
          const fmtMins = mins < 10 ? '0' + mins : mins;
          const fmtSecs = secs < 10 ? '0' + secs : secs;
          heroTimerEl.textContent = `${fmtMins}:${fmtSecs}`;
          
          const progressPct = Math.min(100, Math.max(0, ((heroPeriod.durationSecs - heroPeriod.remainingSecs) / heroPeriod.durationSecs) * 100));
          if (heroProgressEl) heroProgressEl.style.width = `${progressPct.toFixed(1)}%`;
        } else if (heroPeriod.status === 'UPCOMING') {
          heroBadgeText.textContent = 'NEXT UP';
          heroTimerEl.textContent = 'Starts Soon';
          if (heroProgressEl) heroProgressEl.style.width = '0%';
        } else {
          heroBadgeText.textContent = 'SESSION ENDED';
          heroTimerEl.textContent = '00:00';
          if (heroProgressEl) heroProgressEl.style.width = '100%';
        }
      }

      // Render Full Timetable Timeline list
      const fullListEl = document.getElementById('timetable-full-list');
      if (fullListEl) {
        fullListEl.innerHTML = computedPeriods.map(p => {
          const isLive = p.status === 'LIVE NOW';
          const isComplete = p.status === 'COMPLETE';
          let statusBadgeHtml = '';

          if (isLive) {
            const mins = Math.floor(p.remainingSecs / 60);
            const secs = p.remainingSecs % 60;
            const fmtM = mins < 10 ? '0' + mins : mins;
            const fmtS = secs < 10 ? '0' + secs : secs;
            statusBadgeHtml = `
              <div style="display: flex; align-items: center; gap: 8px;">
                <span class="live-countdown-badge">
                  <span class="status-dot"></span>
                  <span>${fmtM}:${fmtS} remaining</span>
                </span>
                <span class="badge badge-sage">LIVE NOW</span>
              </div>
            `;
          } else if (isComplete) {
            statusBadgeHtml = `<span class="badge badge-beige">Complete</span>`;
          } else {
            statusBadgeHtml = `<span class="badge" style="background: rgba(28,35,43,0.06); color: var(--color-ink-muted);">Upcoming</span>`;
          }

          return `
            <div class="period-item ${isLive ? 'live-period' : ''} ${isComplete ? 'complete-period' : ''}">
              <div class="period-time-col">
                <span class="period-num">${p.periodNum}</span>
                <span>${p.timeFormatted}</span>
              </div>
              <div class="period-main-col">
                <div class="period-subject-name">
                  <span>${p.name}</span>
                  ${p.isBreak ? '<span class="badge badge-beige" style="font-size: 0.65rem;">Recess</span>' : ''}
                </div>
                <div class="period-meta-text">${p.teacher} · ${p.room}</div>
              </div>
              <div>${statusBadgeHtml}</div>
            </div>
          `;
        }).join('');
      }

      // Render Dashboard Today's Timetable List
      const dashListEl = document.getElementById('dashboard-period-list');
      if (dashListEl) {
        dashListEl.innerHTML = computedPeriods.map(p => {
          const isLive = p.status === 'LIVE NOW';
          const isComplete = p.status === 'COMPLETE';
          
          let badgeHtml = '';
          if (isLive) {
            badgeHtml = `<span class="badge badge-sage"><span class="status-dot"></span>LIVE</span>`;
          } else if (isComplete) {
            badgeHtml = `<span class="badge badge-beige">Done</span>`;
          } else {
            badgeHtml = `<span class="subtext" style="font-size: 0.75rem;">Upcoming</span>`;
          }

          return `
            <div class="period-item ${isLive ? 'live-period' : ''} ${isComplete ? 'complete-period' : ''}" style="padding: 10px 14px;">
              <div style="width: 100px; font-size: var(--text-xs); font-weight: 600; color: var(--color-ink-muted);">
                ${formatTime12(p.startH, p.startM)}
              </div>
              <div style="flex: 1; padding: 0 10px;">
                <div style="font-size: var(--text-sm); font-weight: 600; color: var(--color-ink);">${p.name}</div>
                <div class="subtext" style="font-size: 0.7rem;">${p.room} · ${p.teacher}</div>
              </div>
              <div>${badgeHtml}</div>
            </div>
          `;
        }).join('');
      }
    }

    // Start Real-Time Countdown Tick Loop
    setInterval(() => {
      if (timetableDetectionMode === 'sim') {
        if (simulatedSecondTicker > 0) {
          simulatedSecondTicker--;
        } else {
          simulatedSecondTicker = 50 * 60; // loop period
        }
      }
      updateTimetableState();
    }, 1000);

