# =============================================================================
# BrainzOS Institutional Deployment — Environment Variables (.env)
# =============================================================================
# IMPORTANT SECURITY RULES:
# 1. NEVER commit the real .env file to git or share it outside authorized school IT.
# 2. Generate cryptographically strong random secrets before running `docker compose up`.
#    Run `node scripts/generate-keys.js` to automatically generate valid production keys.
# 3. All data remains strictly on school hardware in `./volumes/db/data` and `./volumes/storage`.
# =============================================================================

# Server Port (Default HTTP 80; use 8080 if 80 is occupied by school gateway)
APP_PORT=80

# School Intranet Domain or Server IP (e.g., http://192.168.1.100 or http://brainzos.school.internal)
SITE_URL=http://localhost
API_EXTERNAL_URL=http://localhost

# PostgreSQL Superuser Password (Min 32 characters, random alphanumeric)
POSTGRES_PASSWORD=replace-with-a-secure-random-db-password-minimum-32-chars

# JWT Secret used by GoTrue Auth, PostgREST, and Realtime (Min 64 characters random)
JWT_SECRET=replace-with-a-secure-random-64-character-jwt-secret-string-here

# Public Anon Key (Signed JWT with role='anon', delivered to frontend browsers)
ANON_KEY=replace-with-generated-anon-jwt-token

# Privileged Service Role Key (Signed JWT with role='service_role' — SERVER-SIDE ONLY)
# NEVER put this key in frontend code or distribute to clients.
SERVICE_ROLE_KEY=replace-with-generated-service-role-jwt-token
